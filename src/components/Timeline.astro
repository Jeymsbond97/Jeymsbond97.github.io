---
import { experience } from '../data/profile';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<ol class="timeline" data-timeline>
  {experience.map((job, i) => (
    <li class:list={['item', { current: job.current }]} data-reveal="left" style={`--i:${i}`}>
      <span class="node" aria-hidden="true"></span>
      <div class="head">
        <h3>{job.title[lang]} <span class="at">· {job.company[lang]}</span></h3>
        <span class="period">{job.period[lang]}</span>
      </div>
      <p class="place">{job.place[lang]}</p>
      <ul class="points">{job.points[lang].map((p) => <li>{p}</li>)}</ul>
      <ul class="tags">{job.tags.map((tg) => <li class="tag">{tg}</li>)}</ul>
    </li>
  ))}
</ol>
<style>
  .timeline { --progress: 0; list-style: none; margin: 0; padding: 0 0 0 36px; position: relative; }
  .timeline::before, .timeline::after { content: ''; position: absolute; left: 9px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; }
  .timeline::before { background: var(--line); }
  .timeline::after { background: var(--accent); transform-origin: top; transform: scaleY(var(--progress)); transition: transform 0.15s linear; }
  .item { position: relative; padding-bottom: var(--s7); }
  .item:last-child { padding-bottom: 0; }
  .node { position: absolute; left: -36px; top: 4px; width: 20px; height: 20px; border-radius: 50%; background: var(--bg); border: 3px solid var(--line-strong); z-index: 1; }
  .current .node { border-color: var(--accent); box-shadow: 0 0 0 6px var(--tint); }
  .current .node::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--accent); }
  .head { display: flex; justify-content: space-between; gap: var(--s3); flex-wrap: wrap; align-items: baseline; }
  h3 { font-size: 1.25rem; }
  .at { color: var(--muted); font-weight: 700; }
  .period { font-size: 0.875rem; font-weight: 600; color: var(--accent); background: var(--tint); padding: 2px 10px; border-radius: 999px; white-space: nowrap; }
  .place { color: var(--muted); font-size: 0.9375rem; margin: 6px 0 var(--s3); }
  .points { padding-left: 1.1em; margin: 0 0 var(--s3); color: var(--ink); }
  .points li { margin-bottom: 6px; }
  .points li::marker { color: var(--accent); }
</style>
