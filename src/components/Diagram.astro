---
/* Holographic data-flow schematic: each lane is a channel of nodes joined by links that carry
   animated packets; every lane feeds a shared bus that ends in the sink. Pure CSS, no JS. */
import { t, type Lang } from '../i18n/ui';
interface Props { lanes: { label: string; nodes: string[] }[]; sink: string; title: string; lang?: Lang }
const { lanes, sink, title, lang = 'en' } = Astro.props;
const max = Math.max(...lanes.map((l) => l.nodes.length));
---
<figure class="dg" aria-label={title} data-reveal style={`--cols:${max}`}>
  <figcaption class="dg__head" aria-hidden="true">
    <span>SCHEMATIC <i>//</i> {t(lang, 'project.flow')}</span>
    <span class="dg__live"><span class="dg__dot"></span>LIVE</span>
  </figcaption>
  <div class="dg__lanes">
    {lanes.map((lane, li) => (
      <div class="lane" style={`--li:${li}`}>
        <p class="lane__label"><span class="lane__ch" aria-hidden="true">CH.{String(li + 1).padStart(2, '0')}</span>{lane.label}</p>
        <ol class="nodes">
          {lane.nodes.map((n, ni) => (
            <li class="node" style={`--ni:${ni}`}><span class="node__idx" aria-hidden="true">{String(ni + 1).padStart(2, '0')}</span><span class="node__txt">{n}</span></li>
          ))}
        </ol>
      </div>
    ))}
  </div>
  <div class="sink">
    <span class="sink__lbl" aria-hidden="true">{t(lang, 'project.flowOut')}</span>
    <span class="sink__dot" aria-hidden="true"></span>
    <span class="sink__txt">{sink}</span>
  </div>
</figure>
<style>
  .dg {
    --link: 40px;   /* gap between nodes, the link runs through it */
    --bus: 28px;    /* right-hand bus column */
    position: relative; margin: 0; padding: clamp(16px, 3vw, 28px); overflow: hidden;
    border: 1px solid var(--line); border-radius: var(--r-card); box-shadow: var(--panel-top);
    background-color: var(--surface);
    background-image:
      radial-gradient(ellipse 50% 60% at 50% 0%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%),
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 100% 100%, 24px 24px, 24px 24px;
  }
  /* hologram scan line drifting down the panel */
  .dg::before {
    content: ''; position: absolute; left: 0; right: 0; top: -30%; height: 30%; pointer-events: none;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent) 7%, transparent), transparent);
    animation: sweep 6s linear infinite;
  }
  @keyframes sweep { to { transform: translateY(440%); } }
  .dg__head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 22px; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .dg__head i { font-style: normal; color: var(--faint); }
  .dg__live { display: inline-flex; align-items: center; gap: 8px; color: var(--ok); }
  .dg__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 8px var(--ok); animation: blink 1.6s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }

  .dg__lanes { position: relative; display: grid; gap: 18px; padding-right: var(--bus); }
  /* the bus: vertical line on the right that collects every lane and drops into the sink */
  .dg__lanes::after {
    content: ''; position: absolute; right: calc(var(--bus) / 2); top: 28px; bottom: -22px; width: 1px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 30%, transparent), var(--accent));
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .lane { position: relative; display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: center; gap: 16px; }
  .lane__label { margin: 0; display: flex; flex-direction: column; gap: 2px; font-family: var(--font-display); font-weight: 600; font-size: 0.9375rem; line-height: 1.2; color: var(--text); }
  .lane__ch { font-family: var(--font-dot); font-weight: 900; font-size: 0.8125rem; letter-spacing: 0.1em; color: var(--accent); }
  .nodes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--link); }
  .node { position: relative; display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 8px 12px; border: 1px solid var(--line-strong); border-radius: 3px; background: color-mix(in srgb, var(--surface-solid) 70%, transparent); box-shadow: var(--panel-top); }
  .node__idx { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.08em; color: var(--faint); align-self: flex-start; padding-top: 2px; }
  .node__txt { font-size: 0.875rem; font-weight: 500; line-height: 1.3; overflow-wrap: anywhere; }
  /* link to the next node, with a packet riding it */
  .node:not(:last-child)::before {
    content: ''; position: absolute; left: 100%; top: 50%; width: var(--link); height: 1px;
    background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--accent) 70%, transparent) 0 3px, transparent 3px 6px);
  }
  .node:not(:last-child)::after {
    content: ''; position: absolute; left: 100%; top: calc(50% - 3px); width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 10px var(--accent), 0 0 2px var(--accent);
    animation: packet 1.8s cubic-bezier(0.6, 0, 0.4, 1) infinite; animation-delay: calc(var(--li) * 0.35s + var(--ni) * 0.6s);
  }
  @keyframes packet { 0% { transform: translateX(0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateX(calc(var(--link) - 6px)); opacity: 0; } }
  /* tap from the lane's last node into the bus */
  .lane { --tapw: calc(var(--bus) / 2); }
  .lane::after {
    content: ''; position: absolute; right: calc(var(--tapw) * -1); top: 50%; width: var(--tapw); height: 1px;
    background: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .node:last-child { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }

  .sink {
    position: relative; margin-top: 22px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    padding: 14px 16px; border: 1px solid var(--accent); border-radius: 3px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 16%, transparent), color-mix(in srgb, var(--accent-2) 10%, transparent));
    box-shadow: var(--glow), inset 0 1px 0 color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .sink__lbl { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .sink__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 30%, transparent); animation: pulse 1.8s var(--ease) infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 9px color-mix(in srgb, var(--accent) 0%, transparent); } }
  .sink__txt { font-weight: 600; font-size: 0.9875rem; }

  /* nodes boot up one by one when the figure enters the view */
  @media (prefers-reduced-motion: no-preference) {
    .dg.is-in .node { animation: boot 0.6s var(--ease) both; animation-delay: calc(var(--li) * 120ms + var(--ni) * 90ms); }
  }
  @keyframes boot { 0% { opacity: 0; transform: translateY(6px); filter: blur(3px); } 60% { opacity: 1; filter: none; } }
  @media (prefers-reduced-motion: reduce) {
    .dg::before, .node::after, .dg__dot, .sink__dot { animation: none !important; }
    .node:not(:last-child)::after { display: none; }
  }

  /* Narrow screens: each lane becomes a vertical chain; packets fall downward. */
  @media (max-width: 720px) {
    .dg { --link: 22px; }
    .dg__lanes { padding-right: 0; gap: 26px; }
    .dg__lanes::after, .lane::after { display: none; }
    .lane { grid-template-columns: 1fr; gap: 10px; }
    .lane__label { flex-direction: row; align-items: baseline; gap: 10px; }
    .nodes { grid-template-columns: 1fr; row-gap: var(--link); }
    .node { min-height: 44px; }
    .node:not(:last-child)::before { left: 22px; top: 100%; width: 1px; height: var(--link); background: repeating-linear-gradient(180deg, color-mix(in srgb, var(--accent) 70%, transparent) 0 3px, transparent 3px 6px); }
    .node:not(:last-child)::after { left: 19px; top: 100%; animation-name: packet-y; }
  }
  @keyframes packet-y { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(calc(var(--link) - 6px)); opacity: 0; } }
</style>
