---
import Icon from './Icon.astro';
import { t, localize, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="id">
        <p class="sig">Tokhirbek Aminjonov</p>
        <p class="role">{t(lang, 'hero.role')}</p>
        <p class="status"><span class="dot" aria-hidden="true"></span>{t(lang, 'footer.status')} · {profile.location[lang]}</p>
      </div>
      <ul class="social">
        <li><a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a></li>
        <li><a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a></li>
        <li><a href={profile.links.youtube} target="_blank" rel="noopener" aria-label="YouTube"><Icon name="youtube" /></a></li>
        <li><a href={localize(lang, '/contact/')} aria-label={t(lang, 'nav.contact')}><Icon name="mail" /></a></li>
      </ul>
    </div>
    <hr class="hud-rule" />
    <div class="bottom">
      <p class="small muted">© {year} Tokhirbek Aminjonov. {t(lang, 'footer.built')}</p>
      <p class="coords" aria-hidden="true">37.5665° N · 126.9780° E</p>
      <a class="small to-top" href="#top"><Icon name="arrow-up" size={16} /> {t(lang, 'footer.top')}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; padding: var(--s8) 0 var(--s6); background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--bg-2) 80%, transparent)); border-top: 1px solid var(--line); }
  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s5); flex-wrap: wrap; padding-bottom: var(--s6); }
  .id p { margin: 0; }
  .sig { font-family: var(--font-dot); font-weight: 900; font-size: clamp(1.25rem, 1rem + 2.4vw, 2.25rem); letter-spacing: 0.06em; line-height: 1.1; text-transform: uppercase; color: var(--text); }
  .role { margin-top: var(--s3) !important; color: var(--muted); font-size: var(--fs-small); }
  .status { display: inline-flex; align-items: flex-start; gap: 10px; margin-top: var(--s3) !important; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--muted); }
  .status .dot { margin-top: 0.35em; }
  .social { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .social a { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: var(--r-btn); color: var(--text); background: var(--surface); transition: transform 0.3s var(--ease), border-color 0.2s, color 0.2s, box-shadow 0.3s; }
  .social a:hover { transform: translateY(-3px); border-color: var(--accent); color: var(--accent); box-shadow: var(--glow); }
  .bottom { display: flex; justify-content: space-between; align-items: center; gap: var(--s4); flex-wrap: wrap; padding-top: var(--s5); }
  .bottom p { margin: 0; }
  .coords { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--track-mono); color: var(--faint); }
  .to-top { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--muted); min-height: 44px; }
  .to-top:hover { color: var(--accent); }
</style>
