---
import type { CollectionEntry } from 'astro:content';
import CoverArt from './CoverArt.astro';
import { t, localize, categoryLabel as cats, type Lang } from '../i18n/ui';
import { postMedia, linkedinOf, kst } from '../lib/content';
interface Props { post: CollectionEntry<'blog'>; slug: string; lang: Lang; index?: number; variant?: 'grid' | 'row' }
const { post, slug, lang, index = 0, variant = 'grid' } = Astro.props;
const d = post.data;
const { images, video, cover } = postMedia(slug, d);
const base = linkedinOf(slug).reactions ?? 0;
const when = kst(d.date);
const pad = (n: number) => String(n).padStart(2, '0');
---
<article class:list={['pc', 'hud-panel', `pc--${variant}`]} data-reveal style={`--i:${index % 6}`}>
  <a class="pc__link" href={localize(lang, `/blog/${slug}/`)}>
    <div class="pc__media">
      {cover
        ? <img src={cover.src} alt={d.coverAlt ?? ''} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
        : <CoverArt seed={slug} label="" sub={d.place ?? cats[d.category][lang]} />}
      <span class="pc__cat" data-theme="dark">{cats[d.category][lang]}</span>
      {video
        ? <span class="pc__badge" data-theme="dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>{t(lang, 'blog.video')}</span>
        : images.length > 1 && <span class="pc__badge" data-theme="dark"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="14" height="13" rx="1.5" /><path d="M7 3h13.5A.5.5 0 0 1 21 3.5V17" /></svg>{pad(images.length)}</span>}
    </div>
    <div class="pc__body">
      <p class="pc__meta">
        <time datetime={d.date.toISOString()}>{when.date}</time>
        <span>{when.time} KST</span>
        {d.place && <span class="pc__place">{d.place}</span>}
      </p>
      <h3>{d.title}</h3>
      <p class="pc__sum">{d.summary}</p>
      <p class="pc__foot">
        <span class="pc__likes" data-likes data-slug={slug} data-base={base}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.4C1.4 7.6 3.6 4.2 7.1 4.2c2 0 3.6 1.1 4.9 2.9 1.3-1.8 2.9-2.9 4.9-2.9 3.5 0 5.7 3.4 4.4 6.9-1.8 4.8-9.3 9.4-9.3 9.4z" /></svg>
          <span data-like-n>{base}</span><span class="sr-only"> {t(lang, 'blog.likes')}</span>
        </span>
        <span class="pc__read" aria-hidden="true">{t(lang, 'blog.read')} <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </p>
    </div>
  </a>
</article>
<script>
  import '../scripts/blog/likes';
</script>
<style>
  .pc { height: 100%; }
  .pc__link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; border-radius: 6px; }
  .pc__link:hover { color: inherit; }
  .pc__link:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }

  .pc__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg-2); border-radius: 5px 5px 0 0; }
  .pc__media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform 0.9s var(--ease, ease-out), filter 0.5s; filter: saturate(0.9); }
  .pc:hover .pc__media img { transform: scale(1.04); filter: saturate(1.05); }
  .pc__media > :global(svg) { width: 100%; height: 100%; }
  /* Scan line sweep on hover */
  .pc__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 0 46%, color-mix(in srgb, var(--accent) 22%, transparent) 50%, transparent 54% 100%); transform: translateY(-100%); opacity: 0; pointer-events: none; }
  .pc:hover .pc__media::after { animation: pc-scan 1.1s var(--ease, ease-out) forwards; }
  @keyframes pc-scan { 0% { transform: translateY(-60%); opacity: 1; } 100% { transform: translateY(60%); opacity: 0; } }

  .pc__cat, .pc__badge {
    position: absolute; top: 10px; z-index: 1; display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 8px;
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text); background: color-mix(in srgb, var(--bg) 62%, transparent); border: 1px solid var(--line-strong); border-radius: var(--r-tag);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .pc__cat { left: 10px; }
  .pc__cat::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 6px var(--accent); }
  .pc__badge { right: 10px; }
  .pc__badge svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.7; }
  .pc__badge svg path[d^='M8'] { fill: currentColor; stroke: none; }

  .pc__body { display: flex; flex-direction: column; flex: 1; padding: 18px 20px 16px; }
  .pc__meta { display: flex; flex-wrap: wrap; gap: 2px 0; margin: 0 0 10px; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .pc__meta > * + *::before { content: '//'; margin: 0 8px; color: var(--faint); }
  .pc__meta time { color: var(--accent); }
  h3 { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.005em; margin: 0 0 8px; overflow-wrap: normal; word-break: keep-all; text-wrap: balance; }
  .pc__sum { margin: 0 0 16px; font-size: 0.9375rem; line-height: 1.55; color: var(--muted); }
  .pc__foot { display: flex; align-items: center; justify-content: space-between; margin: auto 0 0; padding-top: 12px; border-top: 1px dashed var(--line); }
  .pc__likes { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-dot); font-weight: 800; font-size: 1.0625rem; letter-spacing: 0.04em; color: var(--text); font-variant-numeric: tabular-nums; }
  .pc__likes svg { width: 15px; height: 15px; fill: color-mix(in srgb, var(--accent) 30%, transparent); stroke: var(--accent); stroke-width: 1.6; }
  .pc__read { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); transition: color 0.25s; }
  .pc__read svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.6; transition: transform 0.3s var(--ease, ease-out); }
  .pc:hover .pc__read { color: var(--accent); }
  .pc:hover .pc__read svg { transform: translateX(3px); }

  /* Row variant (blog index): photo left, text right */
  .pc--row .pc__link { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); }
  .pc--row .pc__media { aspect-ratio: auto; min-height: 220px; height: 100%; border-radius: 5px 0 0 5px; }
  .pc--row .pc__media > img, .pc--row .pc__media > :global(svg) { position: absolute; inset: 0; }
  .pc--row .pc__body { padding: 22px 26px 18px; }
  .pc--row h3 { font-size: clamp(1.125rem, 1.4vw, 1.375rem); }
  @media (max-width: 680px) {
    .pc--row .pc__link { grid-template-columns: 1fr; }
    .pc--row .pc__media { aspect-ratio: 4 / 3; min-height: 0; height: auto; border-radius: 5px 5px 0 0; }
    .pc--row .pc__body { padding: 18px 18px 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .pc__media img { transition: none; } .pc:hover .pc__media::after { animation: none; } }
</style>
