---
import { Image } from 'astro:assets';
import '@fontsource/doto/800.css';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/jetbrains-mono';
import Icon from './Icon.astro';
import headshot from '../assets/headshot.webp';
import { t, localize, type Lang } from '../i18n/ui';
import { stats } from '../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumePdf = `${base}/resume/Tokhirbek_Aminjonov_Resume_${lang === 'ko' ? 'KO' : 'EN'}.pdf`;
// The two titles stay whole on narrow screens; the line may only break after the separator dot.
const roles = t(lang, 'hero.role').split(' · ');
---
<section class="hero" data-theme="dark" data-lumi data-state="idle" data-model={`${base}/models/lumi.glb`} data-model-bytes="2092828">
  <div class="hero__view">
    <div class="stage" data-lumi-stage>
      <div class="stage__sky" aria-hidden="true">
        <!-- still frames of the scene, shown until three.js has drawn its first frame (see .stage__poster) -->
        <picture>
          <source media="(max-width: 900px)" srcset={`${base}/models/lumi-poster-mobile.webp`} width="1800" height="800" />
          <img class="stage__poster" src={`${base}/models/lumi-poster-desktop.webp`} width="2160" height="1170" alt="" fetchpriority="high" decoding="async" />
        </picture>
      </div>
      <canvas class="stage__canvas" data-lumi-canvas role="img" aria-label={t(lang, 'hero.lumi.label')}></canvas>

      <div class="hud">
        <div class="hud__top" aria-hidden="true">
          <p class="hud__title">LUMI</p>
        </div>

        <div class="load" aria-hidden="true">
          <p class="load__label">{t(lang, 'hero.lumi.loading')} · 2.0 MB <span data-lumi-pct></span></p>
          <span class="load__bar" data-lumi-bar><i></i></span>
        </div>

        <div class="fallback">
          <p class="fallback__title">{t(lang, 'hero.lumi.fallback.title')}</p>
          <p>{t(lang, 'hero.lumi.fallback.body')}</p>
          <a href={localize(lang, '/projects/jaka-lumi/')}>{t(lang, 'hero.lumi.fallback.link')} <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </div>

    <div class="container hero__inner">
      <div class="copy">
        <div class="id">
          <Image src={headshot} alt="Tokhirbek Aminjonov" width={112} height={112} class="id__photo" loading="eager" />
          <p class="id__now"><i class="led"></i>{t(lang, 'hero.now')}</p>
        </div>
        <h1 class="name">
          <span class="name__first" data-decode>Tokhirbek</span>
          <span class="name__last" data-decode>Aminjonov</span>
          {lang === 'ko' && <span class="name__ko">토히르벡 아민조노프</span>}
        </h1>
        <p class="role">{roles.map((r, i) => i < roles.length - 1 ? <Fragment><span class="role__part">{r}&nbsp;·</span>{' '}</Fragment> : <span class="role__part">{r}</span>)}</p>
        <p class="value">{t(lang, 'hero.value')}</p>
        <ul class="facts" aria-label={t(lang, 'hero.facts')}>
          <li class="fact"><Icon name="pin" size={14} />{t(lang, 'hero.status')}</li>
          <li class="fact"><Icon name="globe" size={14} />{t(lang, 'hero.langs')}</li>
          <li class="fact"><Icon name="send" size={14} />{t(lang, 'hero.workmode')}</li>
        </ul>
        <div class="ctas">
          <a class="btn btn-primary" href={localize(lang, '/projects/')} data-magnetic>
            {t(lang, 'hero.cta.projects')} <Icon name="arrow-right" class="arrow" />
          </a>
          <a class="btn" href={resumePdf} download data-magnetic>
            <Icon name="download" /> {t(lang, 'hero.cta.resume')}
          </a>
          <a class="btn btn-ghost" href={localize(lang, '/contact/')} data-magnetic>
            <Icon name="mail" /> {t(lang, 'hero.cta.contact')}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <dl class="stats" data-count-group aria-label={t(lang, 'hero.stats')}>
      {stats.map((s, i) => (
        <div class="stat">
          <dt class="stat__cap">{t(lang, s.key)}</dt>
          <dd class="stat__num">
            <span class="stat__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {'prefix' in s && <span class="stat__pre">{s.prefix}</span>}<span data-count={s.value}>{s.value}</span>{s.suffix}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import '../scripts/lumi3d.ts';
</script>

<style>
  /* The hero is a window into the Lumi scene: always dark, whatever the site theme */
  .hero {
    --bg: #02040a; --bg-2: #060b14; --surface: rgba(10, 18, 30, 0.72); --surface-solid: #0a121e;
    --line: rgba(120, 220, 255, 0.14); --line-strong: rgba(120, 220, 255, 0.32);
    --text: #eef2f5; --ink: #eef2f5; --muted: #8fa0ab; --faint: #5b6b76;
    --accent: #40e6ff; --accent-2: #9a7bff; --ok: #3ef08a; --accent-ink: #001218;
    --glow: 0 0 24px rgba(64, 230, 255, 0.35);
    --f-display: var(--font-display, 'Unbounded Variable', 'Pretendard Variable', sans-serif);
    --f-dot: var(--font-dot, 'Doto', 'JetBrains Mono Variable', monospace);
    --f-mono: var(--font-mono, 'JetBrains Mono Variable', ui-monospace, monospace);
    color-scheme: dark;
    position: relative;
    isolation: isolate;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /* ---------------------------------------------------------------- view: the 3D stage behind the copy */
  .hero__view { position: relative; min-height: clamp(620px, calc(100svh - 120px), 900px); display: flex; align-items: center; }
  .stage { position: absolute; inset: 0; --lumi-focus-x: 0.74; --lumi-focus-y: 0.56; --lumi-fill: 0.6; z-index: 0; }
  .stage__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.1s var(--ease); outline: none; }
  [data-state='ready'] .stage__canvas { opacity: 1; }
  /* the sky drawn in CSS until three.js is ready, so the hero is never an empty box */
  .stage__sky {
    position: absolute; inset: 0; overflow: hidden; container-type: size;
    background:
      radial-gradient(60% 22% at calc(var(--lumi-focus-x) * 100%) 72%, rgba(48, 170, 210, 0.22), transparent 70%),
      linear-gradient(180deg, #010208 0%, #03091a 45%, #072a3a 64%, #02060d 70%, #02040a 100%);
  }
  .stage__sky::after {
    content: ''; position: absolute; inset: 66% 0 0;
    background-image: linear-gradient(rgba(64, 230, 255, 0.14) 1px, transparent 1px), linear-gradient(90deg, rgba(64, 230, 255, 0.14) 1px, transparent 1px);
    background-size: 48px 48px;
    transform: perspective(380px) rotateX(58deg); transform-origin: top;
    mask-image: linear-gradient(transparent, #000 30%, transparent 90%);
  }
  /* Still frame of the scene, so the robot is on screen before WebGL is ready (and stays when WebGL is missing).
     It is placed with the same rules the canvas uses (scene.ts layout()): the robot's anchor point sits at
     (--lumi-focus-x, --lumi-focus-y) of the stage and the robot is min(fill x height, 1.493 x min(fx, 1 - fx) x width) tall
     (1.493 = ROBOT_H x 0.94 / PAD_R). --poster-* record the framing each image was captured with. */
  .stage__poster {
    --poster-x: 0.74; --poster-y: 0.56; --poster-fill: 0.6;
    position: absolute; max-width: none; width: auto;
    height: calc(min(var(--lumi-fill) * 100cqh, 1.493 * min(var(--lumi-focus-x), 1 - var(--lumi-focus-x)) * 100cqw) / var(--poster-fill));
    left: calc(var(--lumi-focus-x) * 100%); top: calc(var(--lumi-focus-y) * 100%);
    translate: calc(var(--poster-x) * -100%) calc(var(--poster-y) * -100%);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    transition: opacity 1.1s var(--ease);
  }
  [data-state='ready'] .stage__poster { opacity: 0; }
  /* readable copy: the scene fades to the page colour behind the text */
  .hero__view::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(2, 4, 10, 0.94) 0%, rgba(2, 4, 10, 0.82) 30%, rgba(2, 4, 10, 0.3) 50%, transparent 62%),
      linear-gradient(180deg, rgba(2, 4, 10, 0.55) 0%, transparent 18%, transparent 88%, rgba(2, 4, 10, 0.8) 100%);
  }

  /* ---------------------------------------------------------------- HUD over the scene */
  .hud { position: absolute; inset: calc(var(--header-h) + 20px) 0 40px 50%; z-index: 2; pointer-events: none; font-family: var(--f-mono); }
  .hud :is(a, button) { pointer-events: auto; }
  .hud__top { position: absolute; top: 0; left: 24px; }
  .hud__title { margin: 0; font-family: var(--f-dot); font-weight: 800; font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1; letter-spacing: 0.08em; color: var(--text); text-shadow: 0 0 18px rgba(64, 230, 255, 0.35); }
  .led { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 8px var(--ok); flex: none; display: inline-block; }

  /* load progress, under the robot so the poster stays visible */
  .load { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); display: grid; gap: 10px; justify-items: center; transition: opacity 0.5s; }
  .load__label { margin: 0; font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); white-space: nowrap; }
  .load__bar { position: relative; width: 180px; height: 2px; background: var(--line); overflow: hidden; --p: 0; }
  .load__bar i { position: absolute; inset: 0; background: var(--accent); box-shadow: var(--glow); transform-origin: left; transform: scaleX(var(--p)); transition: transform 0.2s linear; }
  [data-state='idle'] .load__bar i { width: 30%; transform: none; animation: scan 1.4s ease-in-out infinite; }
  @keyframes scan { from { translate: -100% 0; } to { translate: 340% 0; } }
  :is([data-state='ready'], [data-state='fallback']) .load { opacity: 0; visibility: hidden; }

  .fallback { display: none; position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%); width: min(340px, calc(100% - 48px)); padding: 18px 20px; border: 1px solid var(--line-strong); border-radius: 6px; background: rgba(2, 6, 12, 0.8); font-family: var(--font-body, sans-serif); font-size: 0.9375rem; color: var(--muted); }
  .fallback p { margin: 0 0 10px; }
  .fallback__title { font-family: var(--f-mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .fallback a { pointer-events: auto; color: var(--text); display: inline-flex; align-items: center; gap: 6px; }
  [data-state='fallback'] .fallback { display: block; }

  /* ---------------------------------------------------------------- copy */
  .hero__inner { position: relative; z-index: 3; pointer-events: none; padding-top: calc(var(--header-h) + clamp(28px, 5vh, 64px)); padding-bottom: clamp(28px, 5vh, 56px); }
  .copy { pointer-events: auto; max-width: min(600px, 46%); }
  .id { display: flex; align-items: center; gap: 14px; margin-bottom: clamp(16px, 2.4vh, 24px); }
  .id :global(.id__photo) { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 2px solid var(--bg); box-shadow: 0 0 0 1px var(--line-strong), 0 0 20px rgba(64, 230, 255, 0.18); flex: none; }
  .id__now { margin: 0; display: inline-flex; align-items: center; gap: 10px; font-family: var(--f-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .name { margin: 0; display: flex; flex-direction: column; font-weight: 400; line-height: 0.98; letter-spacing: 0; overflow-wrap: normal; word-break: keep-all; hyphens: manual; }
  .name__first { font-family: var(--f-display); font-weight: 700; font-size: clamp(2.375rem, 5.4vw, 4.375rem); letter-spacing: -0.02em; color: var(--text); }
  /* uppercase: Doto's lowercase j hangs left and reads as a word gap ("Amin jonov") */
  .name__last { font-family: var(--f-dot); font-weight: 800; font-size: clamp(2.4rem, 5.4vw, 4.4rem); text-transform: uppercase; letter-spacing: 0.02em; color: var(--accent); text-shadow: 0 0 22px rgba(64, 230, 255, 0.35); margin-top: 0.06em; }
  .name__ko { margin-top: 0.5em; font-family: var(--font-body, 'Pretendard Variable', sans-serif); font-weight: 600; font-size: clamp(0.9375rem, 1.3vw, 1.125rem); line-height: 1.3; letter-spacing: 0.04em; color: var(--muted); }
  .role { margin: clamp(14px, 2vh, 20px) 0 0; font-family: var(--f-display); font-weight: 500; font-size: clamp(1rem, 1.5vw, 1.25rem); letter-spacing: 0.01em; color: var(--text); }
  .role__part { white-space: nowrap; }
  .value { margin: 12px 0 0; max-width: 54ch; font-size: clamp(1rem, 1.2vw, 1.0625rem); line-height: 1.6; color: #b9c6ce; }
  .facts { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; padding: 0; }
  .fact { display: inline-flex; align-items: center; gap: 8px; padding: 6px 11px; border: 1px solid var(--line-strong); border-radius: 4px; background: rgba(10, 18, 30, 0.6); font-family: var(--f-mono); font-size: 0.75rem; letter-spacing: 0.04em; color: var(--text); white-space: nowrap; }
  .fact :global(svg) { color: var(--accent); flex: none; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(22px, 3.2vh, 32px); }

  /* ---------------------------------------------------------------- stats: HUD frames with dot-matrix numerals */
  .stats { position: relative; z-index: 3; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 0; padding: 0 0 clamp(28px, 4vw, 48px); }
  .stat {
    position: relative; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px;
    padding: 16px 18px 18px; border: 1px solid var(--line); border-radius: 4px;
    background: linear-gradient(180deg, rgba(64, 230, 255, 0.05), transparent 40%), var(--surface);
    box-shadow: inset 0 1px 0 rgba(120, 220, 255, 0.12);
  }
  .stat::before, .stat::after { content: ''; position: absolute; width: 10px; height: 10px; border: 1px solid var(--accent); opacity: 0.8; }
  .stat::before { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .stat::after { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
  .stat__num { margin: 0; display: flex; align-items: baseline; font-family: var(--f-dot); font-weight: 800; font-size: clamp(2.25rem, 3.6vw, 3rem); line-height: 1; color: var(--text); font-variant-numeric: tabular-nums; }
  .stat__idx { position: absolute; top: 10px; right: 12px; font-family: var(--f-mono); font-size: 0.625rem; letter-spacing: 0.12em; color: var(--faint); }
  .stat__pre { font-family: var(--f-mono); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.12em; color: var(--accent); margin-right: 8px; align-self: center; }
  .stat__cap { font-size: 0.875rem; line-height: 1.4; color: var(--muted); }

  /* ---------------------------------------------------------------- medium screens: narrower copy, robot further right */
  @media (max-width: 1180px) {
    .stage { --lumi-focus-x: 0.76; --lumi-fill: 0.56; }
    .hud { left: 54%; }
    .copy { max-width: 52%; }
  }

  /* ---------------------------------------------------------------- phones and tablets: robot above, copy below */
  @media (max-width: 900px) {
    .hero__view { display: block; min-height: 0; }
    .hero__view::before { display: none; }
    .stage { position: relative; height: max(300px, 40svh); margin-top: var(--header-h); --lumi-focus-x: 0.5; --lumi-focus-y: 0.55; --lumi-fill: 0.72; }
    .stage__poster { --poster-x: 0.5; --poster-y: 0.55; --poster-fill: 0.72; }
    .stage::after { content: ''; position: absolute; inset: auto 0 0; height: 64px; background: linear-gradient(transparent, var(--bg)); pointer-events: none; z-index: 1; }
    .hud { inset: 12px 0 10px 0; }
    .hud__top { left: var(--gutter); }
    .hud__title { font-size: 1.5rem; }
    .hero__inner { padding-top: 4px; padding-bottom: 28px; }
    /* first screen on a phone: name, role and the buttons; the longer text follows (no focusable element moves) */
    .copy { max-width: 640px; display: flex; flex-direction: column; }
    .ctas { order: 1; margin-top: 18px; }
    .value { order: 2; margin-top: 20px; }
    .facts { order: 3; margin-top: 16px; }
    .id { gap: 12px; margin-bottom: 12px; }
    .id :global(.id__photo) { width: 44px; height: 44px; }
    .role { margin-top: 10px; }
    .stats { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  }
  @media (max-width: 520px) {
    .stage { --lumi-focus-x: 0.6; }
    .ctas .btn { flex: 1 1 auto; }
    .stat { padding: 14px; }
  }
</style>
