---
import Icon from './Icon.astro';
import { t, localize, type Lang } from '../i18n/ui';
import type { certificates } from '../data/profile';
interface Props { cert: (typeof certificates)[number]; lang: Lang; index?: number }
const { cert, lang, index = 0 } = Astro.props;
---
<article class:list={['card', 'cert', `cert--${cert.accent}`]} data-reveal style={`--i:${index}`}>
  <div class="seal" aria-hidden="true">
    <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" class="ring" /><circle cx="60" cy="60" r="40" class="ring2" /><path d="M42 61 l12 12 l24 -26" class="tick" /></svg>
  </div>
  <div class="body">
    <p class="issuer"><Icon name="award" size={16} /> {cert.issuer} · {t(lang, 'certs.issued')} {cert.issued[lang]}</p>
    <h3>{cert.name[lang]}</h3>
    <p class="muted">{cert.detail[lang]}</p>
    <div class="links">
      {cert.verify && <a class="btn btn-sm btn-primary" href={cert.verify} target="_blank" rel="noopener">{t(lang, 'certs.verify')} <Icon name="external" size={16} /></a>}
      <a class="btn btn-sm" href={localize(lang, cert.post)}>{t(lang, 'certs.post')} <Icon name="arrow-right" size={16} class="arrow" /></a>
    </div>
  </div>
</article>
<style>
  .cert { display: grid; grid-template-columns: 120px 1fr; gap: var(--s5); padding: var(--s6); align-items: start; }
  .seal svg { width: 120px; height: 120px; }
  .ring { fill: var(--tint); stroke: var(--accent); stroke-width: 2; stroke-dasharray: 6 5; transform-origin: center; animation: spin 24s linear infinite; }
  .ring2 { fill: var(--bg); stroke: var(--line-strong); stroke-width: 1.5; }
  .tick { fill: none; stroke: var(--accent); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 60; stroke-dashoffset: 60; }
  :global(.is-in) .tick, .is-in .tick { animation: tick 0.9s 0.3s var(--ease) forwards; }
  @keyframes tick { to { stroke-dashoffset: 0; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  .issuer { display: inline-flex; align-items: center; gap: 6px; font-size: 0.875rem; font-weight: 600; color: var(--accent); margin: 0 0 var(--s2); }
  h3 { font-size: 1.3125rem; margin-bottom: var(--s3); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: var(--s4); position: relative; z-index: 3; }
  @media (max-width: 560px) { .cert { grid-template-columns: 1fr; padding: var(--s5); } .seal svg { width: 84px; height: 84px; } }
</style>
