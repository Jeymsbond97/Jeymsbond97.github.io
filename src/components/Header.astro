---
import Icon from './Icon.astro';
import { t, localize, alternatePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; hasAlternate?: boolean }
const { lang, hasAlternate = true } = Astro.props;
const path = Astro.url.pathname;
const other: Lang = lang === 'en' ? 'ko' : 'en';
const altHref = hasAlternate ? alternatePath(path, other) : localize(other, '/');

const nav = [
  { href: localize(lang, '/projects/'), label: t(lang, 'nav.projects') },
  { href: localize(lang, '/blog/'), label: t(lang, 'nav.blog') },
  { href: localize(lang, '/certificates/'), label: t(lang, 'nav.certificates') },
  { href: localize(lang, '/resume/'), label: t(lang, 'nav.resume') },
];
const contactHref = localize(lang, '/contact/');
const isActive = (href: string) => path.startsWith(href);
// Only the home page has the always-dark hero; the script keeps this in sync on scroll.
const overHero = path === localize(lang, '/');
---
<header class="site-header" data-header data-over-hero={overHero ? '' : undefined}>
  <div class="container bar">
    <a class="brand" href={localize(lang, '/')} aria-label={`Tokhirbek Aminjonov, ${t(lang, 'nav.home')}`}>
      <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
        <path class="brand__hex" d="M35 20 27.5 7h-15L5 20l7.5 13h15z" />
        <path class="brand__ticks" d="M35 20h3M2 20h3M27.5 7l1.5-2.6M12.5 33 11 35.6" />
        <g class="brand__ring">
          <circle cx="20" cy="20" r="10.5" />
          <circle class="brand__sat" cx="20" cy="9.5" r="1.6" />
        </g>
        <circle class="brand__core" cx="20" cy="20" r="3.4" />
      </svg>
      <span class="brand__text" aria-hidden="true">
        <span class="brand__name">TOKHIRBEK</span>
        <span class="brand__sub"><i class="brand__dot"></i>A. <b>//</b> RSE</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {nav.map((n, i) => (
          <li><a href={n.href} class:list={{ active: isActive(n.href) }} aria-current={isActive(n.href) ? 'page' : undefined}><span class="nav__i" aria-hidden="true">0{i + 1}</span>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="lang" href={altHref} hreflang={other} lang={other} aria-label={t(lang, 'lang.switch')} data-astro-reload>
        <span class:list={{ on: lang === 'en' }}>EN</span><span class="sep">/</span><span class:list={{ on: lang === 'ko' }}>KO</span>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label={t(lang, 'theme.toggle')}>
        <Icon name="sun" class="i-sun" /><Icon name="moon" class="i-moon" />
      </button>
      <a class="btn btn-primary btn-sm contact-btn" href={contactHref}>{t(lang, 'nav.contact')}</a>
      <a class="icon-btn contact-icon" href={contactHref} aria-label={t(lang, 'nav.contact')} aria-current={isActive(contactHref) ? 'page' : undefined}><Icon name="mail" /></a>
      <button class="icon-btn burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span class="sr-only">{t(lang, 'nav.menu')}</span>
        <span class="burger__lines" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="container" aria-label="Mobile">
      <ul>
        <li style="--i:0"><a href={localize(lang, '/')}><span class="m-i" aria-hidden="true">00</span>{t(lang, 'nav.home')}</a></li>
        {nav.map((n, i) => <li style={`--i:${i + 1}`}><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}><span class="m-i" aria-hidden="true">0{i + 1}</span>{n.label}</a></li>)}
        <li style={`--i:${nav.length + 1}`}><a href={contactHref} aria-current={isActive(contactHref) ? 'page' : undefined}><span class="m-i" aria-hidden="true">0{nav.length + 1}</span>{t(lang, 'nav.contact')}</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  let ac: AbortController | undefined;
  function setup() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;
    document.body.style.overflow = '';
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    const burger = header.querySelector<HTMLButtonElement>('[data-burger]');
    const panel = header.querySelector<HTMLElement>('[data-mobile-nav]');
    const setInert = (on: boolean) => document.querySelectorAll('main, footer').forEach((el) => ((el as HTMLElement).inert = on));
    const close = () => {
      if (!burger || !panel) return;
      setInert(false);
      burger.setAttribute('aria-expanded', 'false');
      header.classList.remove('menu-open');
      panel.hidden = true;
      document.body.style.overflow = '';
    };
    burger?.addEventListener('click', () => {
      if (!panel) return;
      const open = burger.getAttribute('aria-expanded') !== 'true';
      burger.setAttribute('aria-expanded', String(open));
      header.classList.toggle('menu-open', open);
      panel.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      setInert(open);
      if (open) panel.querySelector('a')?.focus();
    });
    panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && header.classList.contains('menu-open')) { close(); burger?.focus(); } }, { signal });

    header.querySelector('[data-theme-toggle]')?.addEventListener('click', (ev) => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const d = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void>; finished: Promise<void> } };
      if (!d.startViewTransition || reduce) return apply();
      const e = ev as MouseEvent;
      const x = e.clientX || innerWidth - 40;
      const y = e.clientY || 32;
      const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add('theme-switching');
      const vt = d.startViewTransition(apply);
      vt.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
          { duration: 650, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' }
        );
      });
      vt.finished.finally(() => root.classList.remove('theme-switching'));
    });

    // The hero stays dark in both themes: while the header sits on it, the header uses dark tokens (see CSS).
    const hero = document.querySelector<HTMLElement>('[data-lumi]');
    const syncHero = () => header.toggleAttribute('data-over-hero', !!hero && hero.getBoundingClientRect().bottom > header.offsetHeight);
    addEventListener('resize', syncHero, { passive: true, signal });

    let last = scrollY;
    const onScroll = () => {
      const y = scrollY;
      syncHero();
      header.classList.toggle('scrolled', y > 8);
      if (!header.classList.contains('menu-open')) header.classList.toggle('hide', y > last && y > 240);
      last = y;
    };
    addEventListener('scroll', onScroll, { passive: true, signal });
    onScroll();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 50; height: var(--header-h);
    transition: transform 0.4s var(--ease), background-color 0.3s, border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .site-header.scrolled, .site-header.menu-open {
    background: var(--glass); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom-color: var(--line);
  }
  /* Thin accent trace along the bottom edge once the page scrolls */
  .site-header::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; opacity: 0; transition: opacity 0.3s;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 60%, transparent) 30%, color-mix(in srgb, var(--accent-2) 50%, transparent) 70%, transparent);
  }
  .site-header.scrolled::after { opacity: 1; }
  .site-header.hide { transform: translateY(-100%); }
  .site-header:focus-within { transform: none; }
  /* Light theme over the dark hero: dark tokens, unless the full-screen menu (page colours) is open */
  :global(:root[data-theme='light']) .site-header[data-over-hero]:not(.menu-open) {
    --text: #eef2f5; --ink: #eef2f5; --muted: #8fa0ab; --faint: #5b6b76;
    --line: rgba(120, 220, 255, 0.14); --line-strong: rgba(120, 220, 255, 0.32);
    --accent: #40e6ff; --accent-2: #9a7bff; --ok: #3ef08a; --accent-ink: #001218;
    --glow: 0 0 24px rgba(64, 230, 255, 0.35);
    --tint: rgba(64, 230, 255, 0.12);
    --glass: rgba(2, 4, 10, 0.74);
    color-scheme: dark;
    color: var(--text);
  }
  .bar { height: 100%; display: flex; align-items: center; gap: var(--s4); }

  /* Brand: animated joint emblem + dot-matrix wordmark */
  .brand { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; flex: none; text-decoration: none; min-height: 44px; color: var(--text); }
  .brand:hover { color: var(--text); }
  .brand__mark { width: 34px; height: 34px; flex: none; fill: none; overflow: visible; }
  .brand__hex { stroke: var(--line-strong); stroke-width: 1.4; stroke-linejoin: round; transition: stroke 0.3s; }
  .brand__ticks { stroke: var(--accent); stroke-width: 1.2; stroke-linecap: round; opacity: 0.7; }
  /* the emblem only turns on hover: a forever-running SVG animation repaints the blurred sticky header every frame */
  .brand__ring { transform-origin: 20px 20px; animation: brand-spin 4s linear infinite paused; }
  .brand__ring circle:first-child { stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 2.4 3.2; opacity: 0.85; }
  .brand__sat { fill: var(--accent-2); stroke: none; }
  .brand__core { fill: var(--accent); filter: drop-shadow(0 0 3px var(--accent)); transform-origin: 20px 20px; }
  .brand:hover .brand__hex { stroke: var(--accent); }
  .brand:hover .brand__ring { animation-play-state: running; }
  @keyframes brand-spin { to { transform: rotate(360deg); } }

  .brand__text { display: grid; gap: 1px; line-height: 1; }
  .brand__name { font-family: var(--font-dot); font-weight: 900; font-size: 1.0625rem; letter-spacing: 0.06em; }
  .brand__sub { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; letter-spacing: var(--track-mono); color: var(--muted); }
  .brand__sub b { font-weight: 500; color: var(--faint); }
  .brand__dot { width: 5px; height: 5px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 6px var(--ok); }

  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav a {
    position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px;
    text-decoration: none; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--muted); border-radius: var(--r-btn); transition: color 0.15s;
  }
  .nav__i { font-family: var(--font-dot); font-weight: 900; font-size: 0.8125rem; color: var(--faint); letter-spacing: 0.04em; transition: color 0.15s; }
  .nav a:hover, .nav a.active { color: var(--text); }
  .nav a:hover .nav__i, .nav a.active .nav__i { color: var(--accent); }
  .nav a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 8px; height: 1px; background: var(--accent); box-shadow: 0 0 6px var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease); }
  .nav a:hover::after, .nav a.active::after { transform: scaleX(1); }

  .actions { display: flex; align-items: center; gap: 4px; }
  .lang { display: inline-flex; align-items: center; gap: 2px; min-height: 44px; padding: 0 8px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; text-decoration: none; color: var(--faint); border-radius: var(--r-btn); letter-spacing: 0.08em; }
  .lang .on { color: var(--accent); }
  .lang .sep { opacity: 0.5; margin: 0 2px; }
  .lang:hover { background: var(--tint); color: var(--muted); }
  .icon-btn { width: 44px; height: 44px; display: inline-grid; place-items: center; border: 1px solid transparent; background: transparent; border-radius: var(--r-btn); cursor: pointer; color: var(--text); transition: border-color 0.2s, background-color 0.2s, color 0.2s; }
  .icon-btn:hover { background: var(--tint); border-color: var(--line); color: var(--accent); }
  .icon-btn :global(svg) { transition: transform 0.5s var(--ease), opacity 0.3s; }
  .icon-btn :global(.i-moon) { display: none; }
  :global(:root[data-theme='dark']) .icon-btn :global(.i-sun) { display: none; }
  :global(:root[data-theme='dark']) .icon-btn :global(.i-moon) { display: block; }
  .icon-btn:hover :global(.i-sun) { transform: rotate(90deg); }
  .icon-btn:hover :global(.i-moon) { transform: rotate(-20deg); }
  .contact-btn { margin-left: 8px; }

  .contact-icon { display: none; border-color: var(--line-strong); color: var(--accent); }
  .contact-icon[aria-current='page'] { border-color: var(--accent); background: var(--tint); }
  .burger { display: none; }
  .burger__lines { position: relative; width: 20px; height: 14px; display: block; }
  .burger__lines i { position: absolute; left: 0; width: 100%; height: 1.5px; background: currentColor; transition: transform 0.35s var(--ease), opacity 0.2s, top 0.35s var(--ease), width 0.35s var(--ease); }
  .burger__lines i:nth-child(1) { top: 0; }
  .burger__lines i:nth-child(2) { top: 6px; width: 70%; }
  .burger__lines i:nth-child(3) { top: 12px; }
  .menu-open .burger__lines i:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .menu-open .burger__lines i:nth-child(2) { opacity: 0; }
  .menu-open .burger__lines i:nth-child(3) { top: 6px; transform: rotate(-45deg); }

  .mobile-nav { position: fixed; inset: var(--header-h) 0 0; background: var(--bg); overflow-y: auto; }
  .mobile-nav::before { content: ''; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 32px 32px; mask-image: linear-gradient(to bottom, #000, transparent 80%); -webkit-mask-image: linear-gradient(to bottom, #000, transparent 80%); }
  .mobile-nav ul { position: relative; list-style: none; margin: 0; padding: var(--s6) 0; }
  .mobile-nav li { border-bottom: 1px solid var(--line); animation: menu-in 0.5s var(--ease) both; animation-delay: calc(var(--i) * 50ms); }
  .mobile-nav a { display: flex; align-items: baseline; gap: 14px; min-height: 64px; padding-block: 14px; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.375rem, 6vw, 1.75rem); text-decoration: none; letter-spacing: -0.01em; }
  .mobile-nav a[aria-current='page'] { color: var(--accent); }
  .m-i { font-family: var(--font-dot); font-weight: 900; font-size: 0.875rem; color: var(--accent); letter-spacing: 0.06em; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(14px); } }

  @media (max-width: 960px) {
    .nav, .contact-btn { display: none; }
    .burger, .contact-icon { display: inline-grid; }
    .actions { margin-left: auto; }
  }
  @media (max-width: 374px) {
    .brand { gap: 8px; }
    .brand__mark { width: 30px; height: 30px; }
    .brand__name { font-size: 0.9375rem; }
    .lang { padding: 0 6px; }
  }
</style>
