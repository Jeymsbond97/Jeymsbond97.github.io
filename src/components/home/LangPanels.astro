---
/* Language tests as "transmission" panels: a big dot-matrix score per test, plus Uzbek (native).
   Used on the home page and on the certificates page; the parent renders the heading. */
import { languageTests } from '../../data/profile';
import { t, type Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;

const panels = [
  ...languageTests.map((l) => ({
    language: l.lang[lang],
    score: l.score,
    unit: l.unit[lang],
    test: `${l.name} · ${l.date[lang]}`,
    note: l.name === 'TOPIK' ? t(lang, 'lang.daily') : undefined,
    native: false,
  })),
  { language: t(lang, 'lang.english'), score: t(lang, 'lang.fluent'), unit: '', test: t(lang, 'lang.work'), note: undefined, native: true },
  { language: t(lang, 'lang.uzbek'), score: t(lang, 'lang.native'), unit: '', test: t(lang, 'lang.first'), note: undefined, native: true },
];
// A fixed waveform path per panel (decorative).
const waves = [
  'M0 20 Q10 4 20 20 T40 20 T60 20 T80 20 T100 20 T120 20 T140 20 T160 20 T180 20 T200 20',
  'M0 20 Q6 8 12 20 T24 20 T36 20 T48 20 T60 20 T72 20 T84 20 T96 20 T108 20 T120 20 T132 20 T144 20 T156 20 T168 20 T180 20 T192 20 T204 20',
  'M0 20 Q15 10 30 20 T60 20 T90 20 T120 20 T150 20 T180 20 T210 20',
];
---
<ul class="tx" data-stagger>
  {panels.map((p, i) => (
    <li class:list={['tx__panel', 'hud-panel', { 'tx__panel--native': p.native }]} data-reveal>
      <div class="tx__bar" aria-hidden="true">
        <span>TX.{String(i + 1).padStart(2, '0')}</span>
        <span class="tx__sig"><i></i><i></i><i></i><i></i></span>
      </div>
      <p class="tx__lang">{p.language}</p>
      <p class="tx__score">
        <span class:list={['tx__num', { 'tx__num--word': p.native }]}>{p.score}</span>
        {p.unit && <span class="tx__unit">{p.unit}</span>}
      </p>
      <p class="tx__test">{p.test}</p>
      {p.note && <p class="tx__note">{p.note}</p>}
      <svg class="tx__wave" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={waves[i % waves.length]} /></svg>
    </li>
  ))}
</ul>

<style>
  .tx { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1.15fr 1.15fr 0.9fr; gap: var(--s4); }
  .tx__panel { padding: var(--s5) var(--s5) 56px; display: flex; flex-direction: column; min-height: 230px; }
  .tx__panel > :not(.tx__wave) { position: relative; z-index: 2; }
  .tx__bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s4); font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em; color: var(--faint); }
  .tx__sig { display: inline-flex; align-items: flex-end; gap: 3px; height: 12px; }
  .tx__sig i { width: 3px; background: var(--accent); opacity: 0.85; }
  .tx__sig i:nth-child(1) { height: 25%; } .tx__sig i:nth-child(2) { height: 50%; } .tx__sig i:nth-child(3) { height: 75%; } .tx__sig i:nth-child(4) { height: 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .tx__sig i { animation: sig 1.8s ease-in-out infinite; }
    .tx__sig i:nth-child(2) { animation-delay: 0.15s; } .tx__sig i:nth-child(3) { animation-delay: 0.3s; } .tx__sig i:nth-child(4) { animation-delay: 0.45s; }
  }
  @keyframes sig { 0%, 100% { opacity: 0.9; } 50% { opacity: 0.3; } }

  .tx__lang { margin: 0 0 var(--s2); font-family: var(--font-display); font-weight: 600; font-size: 1.125rem; color: var(--text); }
  .tx__score { display: flex; align-items: baseline; gap: 10px; margin: 0 0 var(--s3); }
  .tx__num { font-family: var(--font-dot); font-weight: 900; font-size: clamp(3.25rem, 2.4rem + 3vw, 4.75rem); line-height: 0.9; letter-spacing: 0.02em; color: var(--accent); text-shadow: 0 0 28px color-mix(in srgb, var(--accent) 40%, transparent); }
  .tx__num--word { text-transform: uppercase; font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem); line-height: 1.1; color: var(--accent-2); text-shadow: 0 0 22px color-mix(in srgb, var(--accent-2) 40%, transparent); }
  .tx__unit { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .tx__test { margin: auto 0 0; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: 0.08em; color: var(--muted); }
  .tx__note { margin: 4px 0 0; font-size: 0.875rem; color: var(--muted); }
  .tx__wave { position: absolute; left: 0; right: 0; bottom: 12px; width: 100%; height: 32px; pointer-events: none; }
  .tx__wave path { fill: none; stroke: color-mix(in srgb, var(--accent) 45%, transparent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .tx__panel--native .tx__wave path { stroke: color-mix(in srgb, var(--accent-2) 45%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .tx__wave path { stroke-dasharray: 6 4; animation: wave 6s linear infinite; }
  }
  @keyframes wave { to { stroke-dashoffset: -100; } }

  @media (max-width: 860px) { .tx { grid-template-columns: 1fr 1fr; } .tx__panel--native { grid-column: span 2; min-height: 0; } }
  @media (max-width: 520px) { .tx { grid-template-columns: 1fr; } .tx__panel--native { grid-column: auto; } .tx__panel { min-height: 0; } }
</style>
