---
// The post body exactly as written (see postHtml): paragraphs, line breaks, emoji, links, hashtag chips.
import { postHtml } from '../../lib/content';
interface Props { text: string; lang?: string; class?: string }
const { text, lang, class: cls } = Astro.props;
---
<div class:list={['post-text', cls]} lang={lang} set:html={postHtml(text)} />
<style>
  .post-text { font-size: clamp(1.0625rem, 0.4vw + 1rem, 1.1875rem); line-height: 1.72; color: var(--text); overflow-wrap: anywhere; }
  .post-text :global(p) { margin: 0 0 1.1em; max-width: 64ch; }
  .post-text :global(p:last-child) { margin-bottom: 0; }
  .post-text :global(.lede) { font-size: 1.08em; font-weight: 600; }
  .post-text :global(a) { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; word-break: break-all; }
  .post-text :global(a:hover) { text-decoration-thickness: 2px; }
  .post-text :global(.htag) {
    display: inline-block; font-family: var(--font-mono); font-size: 0.72em; letter-spacing: 0.04em; line-height: 1;
    padding: 0.42em 0.6em; margin: 0.1em 0; border: 1px solid var(--line-strong); border-radius: 4px;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 7%, transparent); vertical-align: 0.12em; white-space: nowrap;
  }
  .post-text :global(.htags) { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.6em; font-weight: 400; font-size: 1em; }
  .post-text :global(.htags .htag) { margin: 0; vertical-align: baseline; }
</style>
