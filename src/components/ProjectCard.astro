---
import type { CollectionEntry } from 'astro:content';
import CoverArt from './CoverArt.astro';
import Icon from './Icon.astro';
import { t, localize, type Lang } from '../i18n/ui';
interface Props { project: CollectionEntry<'projects'>; lang: Lang; slug: string; index?: number; size?: 'lg' | 'md' }
const { project, lang, slug, index = 0, size = 'md' } = Astro.props;
const d = project.data;
const svgKind = d.cover.startsWith('svg:') ? d.cover.slice(4) : null;
---
<article class:list={['card', 'pcard', `pcard--${size}`]} data-reveal style={`--i:${index}`}>
  <a class="card-link" href={localize(lang, `/projects/${slug}/`)}>
    <div class="media">
      {svgKind ? <CoverArt seed={slug} kind={svgKind} label={d.coverAlt} /> : <img src={d.cover} alt={d.coverAlt} loading="lazy" decoding="async" width="1280" height="720" />}
      <span class="status">{d.status}</span>
    </div>
    <div class="body">
      <h3>{d.title}</h3>
      <p class="outcome">{d.outcome}</p>
      <ul class="tags">{d.tags.slice(0, 5).map((tg) => <li class="tag">{tg}</li>)}</ul>
      <span class="more">{t(lang, 'view.case')} <Icon name="arrow-up-right" size={18} /></span>
    </div>
  </a>
</article>
<style>
  .pcard .media { aspect-ratio: 16 / 10; }
  .status { position: absolute; left: 12px; bottom: 12px; z-index: 1; max-width: calc(100% - 24px); font-size: 0.75rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: var(--glass); color: var(--ink); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .body { padding: var(--s5); display: flex; flex-direction: column; gap: var(--s3); }
  h3 { font-size: 1.3125rem; }
  .outcome { color: var(--muted); margin: 0; font-size: 0.9875rem; }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.9375rem; color: var(--accent); margin-top: var(--s2); }
  .more :global(svg) { transition: transform 0.3s var(--ease); }
  .pcard:hover .more :global(svg) { transform: translate(3px, -3px); }
  .pcard--lg h3 { font-size: clamp(1.375rem, 2.2vw, 1.75rem); }
  .pcard--lg .card-link { display: flex; flex-direction: column; }
  .pcard--lg .media { flex: 1 1 auto; aspect-ratio: auto; min-height: 280px; }
  .pcard--lg .media img { position: absolute; inset: 0; }
</style>
