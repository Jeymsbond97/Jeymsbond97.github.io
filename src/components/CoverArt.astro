---
/* Generated cover for posts/projects without a photo. Deterministic per seed.
   kind="llm" renders a concrete mock-up of the LLM block-coding flow (HTML, scales with its box). */
import { t, type Lang } from '../i18n/ui';
interface Props { seed: string; kind?: string; label?: string; sub?: string; lang?: Lang }
const { seed, kind = 'default', label = '', sub = '', lang = 'en' } = Astro.props;
let h = 2166136261;
for (const c of seed) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); }
const rnd = () => { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; return ((h >>> 0) % 1000) / 1000; };
const pts = Array.from({ length: 4 }, (_, i) => [60 + i * 100 + rnd() * 40, 70 + rnd() * 120]);
const d = 'M' + pts.map((p) => p.map((n) => n.toFixed(0)).join(' ')).join(' L');

/* Illustrative program for the LLM mock-up. Names follow JAKA motion/IO vocabulary; this is not a recorded program. */
const blocks = [
  { k: 'move', op: 'MoveJ', arg: 'home' },
  { k: 'move', op: 'MoveL', arg: 'conveyor.pick' },
  { k: 'io', op: 'Set DO1', arg: 'gripper ON' },
  { k: 'move', op: 'MoveJ', arg: 'pallet.slot[n]' },
  { k: 'move', op: 'MoveL', arg: 'place' },
  { k: 'io', op: 'Set DO1', arg: 'gripper OFF' },
];
---
{kind === 'llm' ? (
  <div class="llm" role="img" aria-label={label}><div class="llm__in">
    <div class="llm__bar" aria-hidden="true">
      <span>LLM <i>→</i> JAKA BLOCK CODE</span>
      <span class="llm__mock">{t(lang, 'project.mockup')}</span>
    </div>
    <div class="llm__body" aria-hidden="true">
      <div class="llm__chat">
        <span class="llm__who"><b></b>{t(lang, 'project.llm.operator')}</span>
        <p class="llm__bubble">{t(lang, 'project.llm.prompt')}<span class="llm__caret"></span></p>
        <span class="llm__tool">tool_call <i>→</i> build_program()</span>
      </div>
      <div class="llm__link"><span></span></div>
      <div class="llm__prog">
        <span class="llm__ttl">{t(lang, 'project.llm.program')}</span>
        <ol>
          {blocks.map((b, i) => <li class={`blk blk--${b.k}`} style={`--bi:${i}`}><b>{b.op}</b><span>{b.arg}</span></li>)}
        </ol>
      </div>
    </div>
    <div class="llm__stamp" aria-hidden="true">
      <strong>✓ {t(lang, 'project.llm.safe')}</strong>
      <span>{t(lang, 'project.llm.checks')}</span>
    </div>
  </div></div>
) : (
  <svg class="cover-art" viewBox="0 0 480 300" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
    <defs>
      <pattern id={`g-${seed}`} width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" /></pattern>
    </defs>
    <rect width="480" height="300" class="bg" />
    <rect width="480" height="300" fill={`url(#g-${seed})`} class="grid" />
    {kind === 'humanoid' ? (
      <g class="fig" transform="translate(240 150)">
        <circle cx="0" cy="-96" r="18" />
        <line x1="0" y1="-78" x2="0" y2="0" />
        <line x1="0" y1="-62" x2="-46" y2="-24" /><line x1="-46" y1="-24" x2="-58" y2="16" />
        <line x1="0" y1="-62" x2="46" y2="-24" /><line x1="46" y1="-24" x2="58" y2="16" />
        <line x1="0" y1="0" x2="-26" y2="60" /><line x1="-26" y1="60" x2="-30" y2="120" />
        <line x1="0" y1="0" x2="26" y2="60" /><line x1="26" y1="60" x2="34" y2="120" />
        {[[0,-62],[-46,-24],[46,-24],[0,0],[-26,60],[26,60],[-58,16],[58,16]].map(([x,y]) => <circle class="j" cx={x} cy={y} r="6" />)}
      </g>
    ) : (
      <g class="fig">
        <path d={d} class="flow" />
        {pts.map(([x, y], i) => <g transform={`translate(${x} ${y})`}><circle class="j" r="8" /><text x="14" y="-10">P{i + 1}</text></g>)}
      </g>
    )}
    {sub && <text x="24" y="276" class="sub">{sub}</text>}
  </svg>
)}
<style>
  /* ---- generic blueprint art ---- */
  .cover-art { width: 100%; height: 100%; display: block; }
  .bg { fill: var(--bg-2); }
  pattern path { fill: none; stroke: color-mix(in srgb, var(--accent) 16%, transparent); stroke-width: 1; }
  .fig { fill: none; stroke: var(--text); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .fig circle:not(.j) { fill: var(--bg-2); }
  .j { fill: var(--bg-2); stroke: var(--accent); stroke-width: 2.5; }
  .flow { stroke: var(--accent); stroke-dasharray: 8 7; animation: flow 1.6s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -30; } }
  text { font: 500 12px var(--font-mono); letter-spacing: 0.08em; fill: var(--accent); stroke: none; }
  .sub { font: 600 20px var(--font-display); fill: var(--text); letter-spacing: -0.01em; }

  /* ---- LLM flow mock-up: sized from its own width (container query units) ---- */
  .llm { container-type: inline-size; width: 100%; height: 100%; }
  .llm__in {
    position: relative; width: 100%; height: 100%; overflow: hidden;
    display: flex; flex-direction: column; gap: 2.4cqi; padding: 9cqi 4cqi 11cqi;
    font-family: var(--font-body); font-size: clamp(7px, 2.35cqi, 22px); line-height: 1.35; color: var(--text);
    background-color: var(--bg-2);
    background-image:
      radial-gradient(ellipse 60% 70% at 85% 30%, color-mix(in srgb, var(--accent-2) 14%, transparent), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--accent) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 7%, transparent) 1px, transparent 1px);
    background-size: 100% 100%, 5cqi 5cqi, 5cqi 5cqi;
  }
  .llm i { font-style: normal; color: var(--accent); }
  .llm__bar { display: flex; justify-content: space-between; gap: 1em; font-family: var(--font-mono); font-size: 0.78em; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .llm__mock { color: var(--faint); border: 1px solid var(--line); padding: 0 0.6em; border-radius: 2px; }
  .llm__body { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 6cqi 1.08fr; align-items: center; }
  .llm__chat { display: flex; flex-direction: column; gap: 0.7em; }
  .llm__who { display: inline-flex; align-items: center; gap: 0.5em; font-family: var(--font-mono); font-size: 0.75em; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .llm__who b { width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0.8em var(--ok); }
  .llm__bubble {
    margin: 0; padding: 0.8em 0.95em; font-size: 1.05em; font-weight: 500; line-height: 1.4;
    border: 1px solid var(--line-strong); border-radius: 0.2em 0.9em 0.9em 0.9em;
    background: color-mix(in srgb, var(--surface-solid) 80%, transparent); box-shadow: var(--panel-top);
  }
  .llm__caret { display: inline-block; width: 0.5em; height: 1em; margin-left: 0.15em; vertical-align: -0.12em; background: var(--accent); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .llm__tool { font-family: var(--font-mono); font-size: 0.75em; color: var(--accent-2); letter-spacing: 0.04em; }
  .llm__link { position: relative; height: 1px; margin: 0 0.6cqi; background: repeating-linear-gradient(90deg, var(--accent) 0 4px, transparent 4px 8px); }
  .llm__link span { position: absolute; top: -0.25em; left: 0; width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0.8em var(--accent); animation: hop 1.8s linear infinite; }
  @keyframes hop { from { left: 0; } to { left: calc(100% - 0.5em); } }
  .llm__prog { padding: 0.8em; border: 1px solid var(--line); border-radius: 0.3em; background: color-mix(in srgb, var(--bg) 55%, transparent); }
  .llm__ttl { display: block; margin-bottom: 0.6em; font-family: var(--font-mono); font-size: 0.7em; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .llm ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.32em; }
  .blk {
    --c: var(--accent);
    position: relative; display: flex; align-items: baseline; gap: 0.6em; padding: 0.28em 0.6em 0.28em 0.75em;
    font-family: var(--font-mono); font-size: 0.82em; white-space: nowrap; overflow: hidden;
    border-radius: 0.2em; border-left: 0.3em solid var(--c);
    background: color-mix(in srgb, var(--c) 16%, transparent);
  }
  .blk::before { content: ''; position: absolute; left: 1.1em; top: 0; width: 1.1em; height: 0.22em; border-radius: 0 0 0.2em 0.2em; background: color-mix(in srgb, var(--c) 45%, transparent); }
  .blk b { font-weight: 700; color: var(--c); min-width: 4.6em; }
  .blk span { color: var(--text); overflow: hidden; text-overflow: ellipsis; }
  .blk--io { --c: var(--accent-2); }
  .llm__stamp {
    position: absolute; right: 4cqi; bottom: 3cqi; display: flex; flex-direction: column; align-items: center; gap: 0.15em;
    padding: 0.45em 0.9em; border: 2px solid var(--ok); border-radius: 0.25em; color: var(--ok);
    background: color-mix(in srgb, var(--bg) 78%, transparent); transform: rotate(-5deg);
    box-shadow: 0 0 1.4em color-mix(in srgb, var(--ok) 35%, transparent), inset 0 0 0.8em color-mix(in srgb, var(--ok) 18%, transparent);
    font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; text-align: center;
  }
  .llm__stamp strong { font-size: 0.95em; font-weight: 800; white-space: nowrap; }
  .llm__stamp span { font-size: 0.62em; opacity: 0.85; white-space: nowrap; }

  /* Entrance once the surrounding card is revealed */
  @media (prefers-reduced-motion: no-preference) {
    :global(.is-in) .blk { animation: blk-in 0.5s var(--ease) both; animation-delay: calc(400ms + var(--bi) * 110ms); }
    :global(.is-in) .llm__stamp { animation: stamp 0.45s cubic-bezier(0.2, 1.6, 0.4, 1) 1.25s both; }
  }
  @keyframes blk-in { from { opacity: 0; transform: translateX(-0.8em); } }
  @keyframes stamp { from { opacity: 0; transform: rotate(-5deg) scale(1.6); } }
  /* small cards: drop secondary lines so the prompt and program stay legible */
  @container (max-width: 420px) { .llm__tool, .llm__mock { display: none; } .llm__in { font-size: 2.6cqi; } }
  @media (prefers-reduced-motion: reduce) { .llm__caret, .llm__link span, .flow { animation: none; } }
</style>
