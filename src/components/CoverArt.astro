---
/* Generated blueprint cover for posts/projects without a photo. Deterministic per seed. */
interface Props { seed: string; kind?: string; label?: string; sub?: string }
const { seed, kind = 'default', label = '', sub = '' } = Astro.props;
let h = 2166136261;
for (const c of seed) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); }
const rnd = () => { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; return ((h >>> 0) % 1000) / 1000; };
const pts = Array.from({ length: 4 }, (_, i) => [60 + i * 100 + rnd() * 40, 70 + rnd() * 120]);
const d = 'M' + pts.map((p) => p.map((n) => n.toFixed(0)).join(' ')).join(' L');
---
<svg class="cover-art" viewBox="0 0 480 300" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
  <defs>
    <pattern id={`g-${seed}`} width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" /></pattern>
  </defs>
  <rect width="480" height="300" class="bg" />
  <rect width="480" height="300" fill={`url(#g-${seed})`} class="grid" />
  {kind === 'humanoid' ? (
    <g class="fig" transform="translate(240 150)">
      <circle cx="0" cy="-96" r="18" />
      <line x1="0" y1="-78" x2="0" y2="0" />
      <line x1="0" y1="-62" x2="-46" y2="-24" /><line x1="-46" y1="-24" x2="-58" y2="16" />
      <line x1="0" y1="-62" x2="46" y2="-24" /><line x1="46" y1="-24" x2="58" y2="16" />
      <line x1="0" y1="0" x2="-26" y2="60" /><line x1="-26" y1="60" x2="-30" y2="120" />
      <line x1="0" y1="0" x2="26" y2="60" /><line x1="26" y1="60" x2="34" y2="120" />
      {[[0,-62],[-46,-24],[46,-24],[0,0],[-26,60],[26,60],[-58,16],[58,16]].map(([x,y]) => <circle class="j" cx={x} cy={y} r="6" />)}
    </g>
  ) : kind === 'llm' ? (
    <g class="fig">
      <rect x="40" y="90" width="150" height="120" rx="12" />
      <line x1="60" y1="120" x2="170" y2="120" /><line x1="60" y1="145" x2="150" y2="145" /><line x1="60" y1="170" x2="160" y2="170" />
      <path d="M200 150 H270" class="flow" />
      <rect x="280" y="70" width="160" height="34" rx="8" class="blk" /><rect x="300" y="112" width="140" height="34" rx="8" class="blk" />
      <rect x="300" y="154" width="140" height="34" rx="8" class="blk" /><rect x="280" y="196" width="160" height="34" rx="8" class="blk" />
    </g>
  ) : (
    <g class="fig">
      <path d={d} class="flow" />
      {pts.map(([x, y], i) => <g transform={`translate(${x} ${y})`}><circle class="j" r="8" /><text x="14" y="-10">P{i + 1}</text></g>)}
    </g>
  )}
  {sub && <text x="24" y="276" class="sub">{sub}</text>}
</svg>
<style>
  .cover-art { width: 100%; height: 100%; display: block; }
  .bg { fill: var(--tint); }
  pattern path { fill: none; stroke: color-mix(in srgb, var(--accent) 16%, transparent); stroke-width: 1; }
  .fig { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .fig circle:not(.j) { fill: var(--bg); }
  .j { fill: var(--bg); stroke: var(--accent); stroke-width: 3; }
  .blk { fill: var(--bg); stroke: var(--accent); }
  .flow { stroke: var(--accent); stroke-dasharray: 8 7; animation: flow 1.6s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -30; } }
  text { font: 700 13px var(--font-body); fill: var(--accent); stroke: none; }
  .sub { font: 800 22px var(--font-head); fill: var(--ink); letter-spacing: -0.02em; }
</style>
