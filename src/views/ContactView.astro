---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { t, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const [user, domain] = profile.email.split('@');
---
<BaseLayout lang={lang} title={t(lang, 'contact.title')} description={t(lang, 'contact.lead')}>
  <PageHead code="COMMS" label={t(lang, 'contact.label')} title={t(lang, 'contact.title')} lead={t(lang, 'contact.lead')} />
  <section class="section">
    <div class="container wrap">
      <form class="hud-panel hud-panel--static form" data-contact-form data-endpoint={profile.formEndpoint} data-web3={profile.web3formsKey} data-reveal novalidate>
        <div class="form__bar" aria-hidden="true">
          <span>TX // {t(lang, 'contact.form.title')}</span>
          <span class="form__live"><span class="dot"></span>{t(lang, 'contact.form.open')}</span>
        </div>
        <input type="hidden" name="_subject" value="New message from your portfolio" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="row">
          <label class="field"><span>{t(lang, 'contact.form.name')} <i aria-hidden="true">*</i></span><input name="name" required autocomplete="name" maxlength="120" /></label>
          <label class="field"><span>{t(lang, 'contact.form.email')} <i aria-hidden="true">*</i></span><input name="email" type="email" required autocomplete="email" maxlength="160" /></label>
        </div>
        <div class="row">
          <label class="field"><span>{t(lang, 'contact.form.company')}</span><input name="company" autocomplete="organization" maxlength="160" /></label>
          <label class="field"><span>{t(lang, 'contact.form.subject')} <i aria-hidden="true">*</i></span><input name="subject" required maxlength="200" /></label>
        </div>
        <label class="field"><span>{t(lang, 'contact.form.message')} <i aria-hidden="true">*</i></span><textarea name="message" rows="7" required maxlength="5000"></textarea></label>
        <div class="submit-row">
          <button class="btn btn-primary" type="submit" data-magnetic>
            <Icon name="send" /> <span class="send-label" data-idle={t(lang, 'contact.form.send')} data-busy={t(lang, 'contact.form.sending')}>{t(lang, 'contact.form.send')}</span>
          </button>
          <p class="hint">{t(lang, 'contact.form.required')}</p>
        </div>
        <p
          class="status"
          role="status"
          aria-live="polite"
          data-ok={t(lang, 'contact.form.ok')}
          data-err={t(lang, 'contact.form.err')}
          data-server={t(lang, 'contact.form.server')}
          data-mail-label={t(lang, 'contact.form.mailto')}
        ></p>
      </form>

      <aside class="side">
        <div class="hud-panel hud-panel--static box" data-reveal style="--i:1">
          <h2 class="hud-label">{t(lang, 'contact.direct')}</h2>
          <ul class="direct">
            <li>
              <span class="ico"><Icon name="mail" /></span>
              <div class="kv"><span class="k">{t(lang, 'contact.email')}</span><a class="v v--mail" data-mail={`${user}|${domain}`} href="#">{user}<wbr /><span aria-hidden="true">@</span><span class="sr-only">at</span>{domain}</a></div>
              <button type="button" class="copy" data-copy={profile.email} data-copied={t(lang, 'contact.copied')} aria-label={t(lang, 'contact.copy.email')}><Icon name="copy" size={16} /><span class="copy-label">{t(lang, 'contact.copy')}</span></button>
            </li>
            <li>
              <span class="ico"><Icon name="pin" /></span>
              <div class="kv"><span class="k">{t(lang, 'contact.base')}</span><span class="v">{t(lang, 'contact.location')}</span></div>
            </li>
          </ul>
        </div>
        <div class="hud-panel hud-panel--static box" data-reveal style="--i:2">
          <h2 class="hud-label">{t(lang, 'contact.social')}</h2>
          <ul class="social">
            <li><a href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> <span>LinkedIn</span><Icon name="arrow-up-right" size={16} class="go" /></a></li>
            <li><a href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" /> <span>GitHub</span><Icon name="arrow-up-right" size={16} class="go" /></a></li>
            <li><a href={profile.links.youtube} target="_blank" rel="noopener"><Icon name="youtube" /> <span>YouTube</span><Icon name="arrow-up-right" size={16} class="go" /></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  /* FormSubmit AJAX answers HTTP 200 even when it refuses a message
     (for example {"success":"false","message":"This form needs Activation..."}
     until the owner confirms the activation email), so the JSON body decides. */
  type Reply = { success?: boolean | string; message?: string };

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-mail]').forEach((a) => {
      const [u, d] = (a.dataset.mail ?? '').split('|');
      a.href = `mailto:${u}@${d}`;
    });
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;
    const status = form.querySelector<HTMLElement>('.status')!;
    const label = form.querySelector<HTMLElement>('.send-label')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const mailHref = document.querySelector<HTMLAnchorElement>('[data-mail]')?.href ?? '';

    let draft = '';
    const show = (kind: 'ok' | 'err', text: string, withMail = false) => {
      status.className = `status ${kind}`;
      status.textContent = text;
      if (withMail && mailHref.startsWith('mailto:')) {
        const a = document.createElement('a');
        // the visitor's own message comes along in their mail app, so nothing they typed is lost
        a.href = mailHref + draft;
        a.textContent = status.dataset.mailLabel ?? '';
        status.append(' ', a);
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'status';
      status.textContent = '';
      if (!form.checkValidity()) {
        form.classList.add('touched');
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      const data = Object.fromEntries(new FormData(form).entries());
      if (data._honey) return;
      btn.disabled = true;
      label.textContent = label.dataset.busy ?? '';
      try {
        const d = data as Record<string, string>;
        draft = `?subject=${encodeURIComponent(d.subject ?? '')}&body=${encodeURIComponent(`${d.message ?? ''}\n\n${d.name ?? ''}${d.company ? `, ${d.company}` : ''}`)}`;
        const key = form.dataset.web3;
        let res: Response;
        try {
          res = key
            ? await fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ access_key: key, from_name: 'Portfolio contact form', ...data, page: location.href }),
                signal: AbortSignal.timeout(20_000),
              })
            : await fetch(form.dataset.endpoint!, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ ...data, _replyto: data.email, page: location.href }),
                signal: AbortSignal.timeout(30_000),
              });
        } catch {
          // Network failure, blocked request, CORS or no answer in time: treat the message as not sent.
          show('err', status.dataset.err ?? '', true);
          return;
        }
        const json: Reply = await res.json().catch(() => ({}));
        const ok = res.ok && (json.success === true || json.success === 'true');
        if (ok) {
          show('ok', status.dataset.ok ?? '');
          form.reset();
          form.classList.remove('touched');
        } else if (json.message) {
          show('err', `${status.dataset.server ?? ''} ${json.message}`.trim(), true);
        } else {
          show('err', status.dataset.err ?? '', true);
        }
      } finally {
        btn.disabled = false;
        label.textContent = label.dataset.idle ?? '';
      }
    });
  });
</script>

<style>
  .wrap { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--s6); align-items: start; }
  .form { padding: clamp(20px, 4vw, 40px); display: grid; gap: var(--s5); }
  .form > * { position: relative; z-index: 2; }
  .form__bar { display: flex; justify-content: space-between; align-items: center; gap: var(--s4); flex-wrap: wrap; padding-bottom: var(--s4); border-bottom: 1px dashed var(--line-strong); font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--accent); }
  .form__live { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s5); }
  .field { display: grid; gap: 8px; font-size: 0.9375rem; font-weight: 600; color: var(--text); }
  .field i { font-style: normal; color: var(--accent); }
  .field input, .field textarea {
    font: inherit; font-weight: 400; color: var(--text); width: 100%; min-height: 48px; padding: 12px 14px;
    background: color-mix(in srgb, var(--bg) 70%, transparent); border: 1px solid var(--line-strong); border-radius: var(--r-btn);
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }
  .field textarea { resize: vertical; min-height: 160px; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--accent); background: var(--bg); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent), var(--glow); }
  .touched .field :invalid { border-color: var(--danger); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .submit-row { display: flex; align-items: center; gap: var(--s4); flex-wrap: wrap; }
  .submit-row .btn[disabled] { opacity: 0.7; cursor: progress; }
  .hint { margin: 0; font-size: var(--fs-small); color: var(--faint); }
  .status { margin: 0; font-weight: 600; font-size: 0.9375rem; }
  .status:empty { display: none; }
  .status.ok, .status.err { padding: 12px 14px; border-radius: var(--r-btn); border: 1px solid; }
  .status.ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, transparent); background: color-mix(in srgb, var(--ok) 8%, transparent); }
  .status.err { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 45%, transparent); background: color-mix(in srgb, var(--danger) 8%, transparent); }
  .status :global(a) { color: var(--text); text-decoration: underline; }
  .side { display: grid; gap: var(--s5); }
  .box { padding: var(--s5); }
  .box > * { position: relative; z-index: 2; }
  .box h2 { display: block; margin-bottom: var(--s4); }
  .direct { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }
  .direct li { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: 12px; }
  .ico { width: 44px; height: 44px; border-radius: var(--r-btn); border: 1px solid var(--line); background: var(--tint); color: var(--accent); display: grid; place-items: center; }
  .k { display: block; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--faint); }
  .v { font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
  a.v:hover { color: var(--accent); }
  /* the address may only wrap before the "@", never inside a word */
  .v--mail { overflow-wrap: normal; font-size: clamp(0.875rem, 0.78rem + 0.5vw, 1rem); }
  .copy { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; border-radius: var(--r-btn); border: 1px solid var(--line); background: transparent; cursor: pointer; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--muted); }
  .copy:hover { border-color: var(--accent); color: var(--accent); }
  .copy:global(.copied) { color: var(--ok); border-color: var(--ok); }
  .social { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .social a { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 14px; border: 1px solid var(--line); border-radius: var(--r-btn); text-decoration: none; font-weight: 600; transition: border-color 0.2s, background-color 0.2s, transform 0.3s var(--ease), color 0.2s; }
  .social a span { flex: 1; }
  .social a:hover { border-color: var(--accent); background: var(--tint); color: var(--accent); transform: translateX(4px); }
  @media (max-width: 900px) { .wrap { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } .copy .copy-label { display: none; } }
</style>
