---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CertCard from '../components/CertCard.astro';
import LangPanels from '../components/home/LangPanels.astro';
import { t, type Lang } from '../i18n/ui';
import { certificates, languageTests } from '../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<BaseLayout lang={lang} title={t(lang, 'certs.title')} description={t(lang, 'certs.lead')}>
  <PageHead label={`${certificates.length} ${lang === 'ko' ? '개 자격증' : 'certificates'}`} title={t(lang, 'certs.title')} lead={t(lang, 'certs.lead')} />
  <section class="section">
    <div class="container">
      <div class="list">{certificates.map((c, i) => <CertCard cert={c} lang={lang} index={i} level={2} />)}</div>
      <div class="sub" data-reveal>
        <p class="section-label">TX<span class="section-label__sep">//</span>{languageTests.length + 1} {lang === 'ko' ? '개 언어' : 'languages'}</p>
        <h2 data-decode>{t(lang, 'certs.languages')}</h2>
      </div>
      <LangPanels lang={lang} />
    </div>
  </section>
</BaseLayout>
<style>
  .list { display: grid; gap: var(--s5); }
  .sub { margin: var(--s8) 0 var(--s5); }
  .sub h2 { margin-top: var(--s3); font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem); }
</style>
