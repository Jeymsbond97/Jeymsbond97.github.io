---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import PostCard from '../components/PostCard.astro';
import { t, categoryLabel as catLabel, type Lang } from '../i18n/ui';
import { getPosts, postMedia, linkedinOf, kst } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = await getPosts(lang);
const years = [...new Set(posts.map((p) => kst(p.entry.data.date).year))];
const catOrder = ['Exhibition', 'Tech', 'Event', 'Career', 'Certificate', 'Life'];
const cats = catOrder.filter((c) => posts.some((p) => p.entry.data.category === c));
const countOf = (c: string) => posts.filter((p) => p.entry.data.category === c).length;
const photos = posts.reduce((n, p) => n + postMedia(p.slug, p.entry.data).images.length, 0);
const reactions = posts.reduce((n, p) => n + (linkedinOf(p.slug).reactions ?? 0), 0);
const pad = (n: number) => String(n).padStart(2, '0');
const stats = [
  { value: pad(posts.length), label: t(lang, 'blog.posts') },
  { value: pad(photos), label: t(lang, 'blog.photos') },
  { value: String(reactions), label: t(lang, 'blog.reactions') },
];
---
<BaseLayout lang={lang} title={t(lang, 'blog.title')} description={t(lang, 'blog.lead')}>
  <PageHead code="LOG" label={t(lang, 'blog.title')} title={t(lang, 'blog.title')} lead={t(lang, 'blog.lead')}>
    <dl class="stats" data-reveal style="--i:3">
      {stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
    <div class="filters" role="group" aria-label={t(lang, 'blog.filter')} data-reveal style="--i:4" data-filters>
      <button type="button" class="chip" data-filter="all" aria-pressed="true">{catLabel.all[lang]}<span>{pad(posts.length)}</span></button>
      {cats.map((c) => <button type="button" class="chip" data-filter={c} aria-pressed="false">{catLabel[c][lang]}<span>{pad(countOf(c))}</span></button>)}
    </div>
  </PageHead>
  <section class="section">
    <div class="container">
      {years.map((y) => (
        <div class="year" data-year>
          <h2 class="year__label"><span>{y}</span></h2>
          <div class="list">
            {posts.filter((p) => kst(p.entry.data.date).year === y).map((p, i) => (
              <div class="item" data-cat={p.entry.data.category}><PostCard post={p.entry} slug={p.slug} lang={lang} index={i} variant="row" /></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
<script>
  import '../scripts/blog/filter';
</script>
<style>
  .stats { display: flex; flex-wrap: wrap; gap: 12px 36px; margin: 28px 0 0; }
  .stats div { display: flex; flex-direction: column-reverse; gap: 4px; }
  .stats dt { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .stats dd { margin: 0; font-family: var(--font-dot); font-weight: 800; font-size: clamp(1.75rem, 3vw, 2.25rem); line-height: 1; color: var(--accent); letter-spacing: 0.04em; }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .chip {
    display: inline-flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 12px 0 14px; cursor: pointer;
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
    border: 1px solid var(--line-strong); border-radius: 4px; background: var(--surface);
    transition: color 0.2s, border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .chip span { font-family: var(--font-dot); font-weight: 800; font-size: 0.875rem; letter-spacing: 0.04em; color: var(--faint); }
  .chip:hover { color: var(--text); border-color: var(--accent); }
  .chip[aria-pressed='true'] { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); box-shadow: var(--glow); }
  .chip[aria-pressed='true'] span { color: var(--accent-ink); opacity: 0.75; }

  .year { display: grid; grid-template-columns: 168px minmax(0, 1fr); gap: 32px; }
  .year + .year { margin-top: 64px; padding-top: 64px; border-top: 1px solid var(--line); }
  .year__label { margin: 0; font-family: var(--font-dot); font-weight: 900; font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1; letter-spacing: 0.02em; color: var(--accent); text-shadow: 0 0 24px color-mix(in srgb, var(--accent) 35%, transparent); }
  .year__label span { position: sticky; top: calc(var(--header-h, 64px) + 24px); display: block; }
  .list { display: grid; gap: 20px; }
  @media (max-width: 860px) {
    .year { grid-template-columns: 1fr; gap: 20px; }
    .year__label span { position: static; }
  }
</style>
