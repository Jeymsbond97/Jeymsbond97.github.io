---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import VideoCard from '../components/VideoCard.astro';
import Timeline from '../components/Timeline.astro';
import Skills from '../components/Skills.astro';
import CertCard from '../components/CertCard.astro';
import ContactBand from '../components/ContactBand.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/home/SectionHead.astro';
import GlyphRule from '../components/home/GlyphRule.astro';
import About from '../components/home/About.astro';
import Education from '../components/home/Education.astro';
import LangPanels from '../components/home/LangPanels.astro';
import PostTeaser from '../components/home/PostTeaser.astro';
import { t, localize, type Lang } from '../i18n/ui';
import { getProjects, getPosts } from '../lib/content';
import { certificates, videos, techMarquee, profile } from '../data/profile';
import linkedin from '../data/linkedin.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = await getProjects(lang);
const robotics = projects.filter((p) => p.entry.data.group === 'robotics' && p.entry.data.featured);
const physical = projects.filter((p) => p.entry.data.group === 'physical-ai' && p.entry.data.featured);

// Blog teaser: only posts with a real photo (LinkedIn images, or the video poster), newest first.
type Synced = { images?: string[]; poster?: string; reactions?: number };
const synced = linkedin as Record<string, Synced>;
const posts = (await getPosts(lang))
  .map((p) => ({ ...p, cover: synced[p.slug]?.images?.[0] ?? synced[p.slug]?.poster, reactions: synced[p.slug]?.reactions }))
  .filter((p): p is typeof p & { cover: string } => Boolean(p.cover))
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumePdf = `${base}/resume/Tokhirbek_Aminjonov_Resume_${lang === 'ko' ? 'KO' : 'EN'}.pdf`;

const title = lang === 'ko' ? 'Tokhirbek Aminjonov · 로봇 소프트웨어 엔지니어' : 'Tokhirbek Aminjonov · Robot Software Engineer';
const description = t(lang, 'hero.value');
---
<BaseLayout lang={lang} title={title} description={description} type="profile">
  <Hero lang={lang} />

  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="marquee__track">{techMarquee.map((m) => <span class="marquee__item">{m}</span>)}</div>
      ))}
    </div>
  </div>

  <About lang={lang} idx={1} />

  <GlyphRule seed={11} />

  <section class="section" id="projects" aria-labelledby="projects-h">
    <div class="container">
      <SectionHead idx={2} label={t(lang, 'nav.projects')} title={t(lang, 'section.featured')} lead={t(lang, 'section.featured.lead')} id="projects-h">
        <a class="btn" href={localize(lang, '/projects/')}>{t(lang, 'all.projects')} <Icon name="arrow-right" class="arrow" /></a>
      </SectionHead>
      <div class="bento">
        {robotics.map((p, i) => <ProjectCard project={p.entry} slug={p.slug} lang={lang} index={i} size={i === 0 ? 'lg' : 'md'} />)}
      </div>
      <div class="strip" data-reveal>
        <p class="strip__text">{t(lang, 'section.contact.lead')}</p>
        <div class="strip__actions">
          <a class="btn btn-primary btn-sm" href={`mailto:${profile.email}`}><Icon name="mail" /> {t(lang, 'contact.band.email')}</a>
          <a class="btn btn-sm" href={resumePdf} download><Icon name="download" /> {t(lang, 'hero.cta.resume')}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section physical" id="physical-ai" aria-labelledby="physical-h">
    <div class="container">
      <SectionHead idx={3} label="Physical AI" title={t(lang, 'section.physical')} lead={t(lang, 'section.physical.lead')} id="physical-h" />
      <div class="grid-3">
        {physical.map((p, i) => <ProjectCard project={p.entry} slug={p.slug} lang={lang} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section" id="videos" aria-labelledby="videos-h">
    <div class="container">
      <SectionHead idx={4} label={t(lang, 'videos.label')} title={t(lang, 'videos.heading')} lead={t(lang, 'videos.lead')} id="videos-h">
        <a class="btn btn-ghost" href={profile.links.youtube} target="_blank" rel="noopener"><Icon name="youtube" /> @jeyms_bond97</a>
      </SectionHead>
      <div class="reel">
        {videos.map((v, i) => (
          <VideoCard id={v.id} title={v.title[lang]} index={i} shape="tall" href={localize(lang, `/projects/${v.project}/`)} />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="exp-h">
    <div class="container">
      <SectionHead idx={5} label={t(lang, 'section.experience')} title={t(lang, 'exp.heading')} lead={t(lang, 'exp.lead')} id="exp-h" />
      <Timeline lang={lang} />
    </div>
  </section>

  <Education lang={lang} idx={6} />

  <section class="section" id="skills" aria-labelledby="skills-h">
    <div class="container">
      <SectionHead idx={7} label={t(lang, 'section.skills')} title={t(lang, 'skills.heading')} lead={t(lang, 'skills.lead')} id="skills-h" />
      <Skills lang={lang} />
    </div>
  </section>

  <section class="section" id="certificates" aria-labelledby="certs-h">
    <div class="container">
      <SectionHead idx={8} label={t(lang, 'nav.certificates')} title={t(lang, 'certs.home.heading')} id="certs-h">
        <a class="btn" href={localize(lang, '/certificates/')}>{t(lang, 'all.certs')} <Icon name="arrow-right" class="arrow" /></a>
      </SectionHead>
      <div class="certs">
        {certificates.map((c, i) => <CertCard cert={c} lang={lang} index={i} />)}
      </div>
      <div class="sub-head" data-reveal>
        <h3>{t(lang, 'certs.languages')}</h3>
        <span class="sub-head__line" aria-hidden="true"></span>
      </div>
      <LangPanels lang={lang} />
    </div>
  </section>

  <GlyphRule seed={29} />

  <section class="section" id="blog" aria-labelledby="blog-h">
    <div class="container">
      <SectionHead idx={9} label={t(lang, 'nav.blog')} title={t(lang, 'section.blog')} lead={t(lang, 'home.blog.lead')} id="blog-h">
        <a class="btn" href={localize(lang, '/blog/')}>{t(lang, 'all.posts')} <Icon name="arrow-right" class="arrow" /></a>
      </SectionHead>
      <div class="grid-3">
        {posts.map((p, i) => <PostTeaser post={p.entry} slug={p.slug} lang={lang} cover={p.cover} reactions={p.reactions} index={i} />)}
      </div>
    </div>
  </section>

  <ContactBand lang={lang} />
</BaseLayout>

<style>
  .marquee-wrap { padding: var(--s5) 0; border-block: 1px solid var(--line); background: color-mix(in srgb, var(--bg-2) 60%, transparent); }

  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); }
  .bento > :global(.pcard--lg) { grid-column: span 2; grid-row: span 2; }
  /* the large card spans two rows: its photo takes the extra height, not the gap above the tags */
  .bento > :global(.pcard--lg) > :global(.card-link) { flex: 1 1 auto; }
  .bento > :global(.pcard--lg) :global(.body) { flex: 0 0 auto; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); }
  /* slim call to action right after the selected projects */
  .strip {
    margin-top: var(--s6); display: flex; align-items: center; justify-content: space-between; gap: var(--s4) var(--s5); flex-wrap: wrap;
    padding: var(--s4) var(--s5); border: 1px solid var(--line-strong); border-radius: var(--r-card);
    background: color-mix(in srgb, var(--accent) 5%, var(--surface)); box-shadow: var(--panel-top);
  }
  .strip__text { margin: 0; max-width: 60ch; font-weight: 500; color: var(--text); }
  .strip__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .physical { background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--accent-2) 5%, transparent) 30%, transparent); }

  /* Field footage: a row of tall 9:16 cards */
  .reel { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--s4); }

  .certs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s5); }
  .sub-head { display: flex; align-items: center; gap: var(--s4); margin: var(--s8) 0 var(--s5); }
  .sub-head h3 { font-family: var(--font-mono); font-weight: 500; font-size: var(--fs-micro); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .sub-head__line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--line-strong), transparent); }

  @media (max-width: 1100px) {
    .reel { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5) var(--s4); }
  }
  @media (max-width: 960px) {
    .bento, .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .certs { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .section { --section: 44px; }
    .strip { padding: var(--s4); }
    .strip__actions, .strip__actions .btn { flex: 1 1 auto; }
    .bento, .grid-3 { grid-template-columns: 1fr; }
    .bento > :global(.pcard--lg) { grid-column: auto; grid-row: auto; }
    .reel { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s4) var(--s3); }
  }
</style>
