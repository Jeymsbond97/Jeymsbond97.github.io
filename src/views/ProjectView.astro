---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import CoverArt from '../components/CoverArt.astro';
import Icon from '../components/Icon.astro';
import { t, localize, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/content';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const all = await getProjects(lang);
const idx = all.findIndex((p) => p.slug === slug);
const { entry } = all[idx];
const next = all[(idx + 1) % all.length];
const prev = all[(idx - 1 + all.length) % all.length];
const d = entry.data;
const { Content } = await render(entry);
const svgKind = d.cover.startsWith('svg:') ? d.cover.slice(4) : null;
const msn = `MSN-${String(d.order).padStart(2, '0')}`;
const work = d.group === 'robotics';
const pad = (n: number) => String(n).padStart(2, '0');
// Spec grid, 3 columns on desktop: period, status, client, then role next to team (2 + 1) or across the row when there is no team.
// On 2 columns client takes the whole row when there is no team to sit beside it.
const facts = [
  { k: t(lang, 'project.period'), v: d.period },
  { k: t(lang, 'project.status'), v: d.status, status: true },
  { k: t(lang, 'project.client'), v: d.client, span: d.team ? undefined : 'pair' },
  { k: t(lang, 'project.myRole'), v: d.role, span: d.team ? 'wide' : 'full' },
  ...(d.team ? [{ k: t(lang, 'project.team'), v: d.team }] : []),
];
const video = d.youtube[0];
// Source access is restricted: buttons keep the old look, but no URL reaches the HTML.
const sources = [...(d.repo ? [{ label: 'GitHub', primary: true }] : []), ...d.links.map((l) => ({ label: l.label, primary: false }))];
---
<BaseLayout lang={lang} title={d.title} description={d.outcome} image={svgKind ? undefined : d.cover} type="article">
  <article>
    <header class="phead">
      <div class="container">
        <a class="back" href={localize(lang, '/projects/')}><Icon name="arrow-left" size={16} /> {t(lang, 'projects.title')}</a>
        <p class="section-label" data-reveal>
          <span class="section-label__idx">{msn}</span><span class="section-label__sep" aria-hidden="true">//</span>
          {d.group === 'physical-ai' ? 'Physical AI' : 'Robotics'} · {work ? t(lang, 'project.work') : t(lang, 'project.independent')}
        </p>
        <h1 data-decode>{d.title}</h1>
        <p class="lead" data-reveal style="--i:2">{d.outcome}</p>
        <dl class="facts card hud-panel--static" aria-label={t(lang, 'project.facts')} data-stagger>
          {facts.map((f) => (
            <div class:list={['fact', f.span && `fact--${f.span}`]} data-reveal>
              <dt>{f.k}</dt>
              <dd>{f.status && <span class:list={['fact__dot', { 'fact__dot--own': !work }]} aria-hidden="true"></span>}{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </header>

    <div class="container">
      <section class:list={['stage', video ? 'stage--video' : 'stage--wide']}>
        {video ? (
          <div class="stage__video" data-reveal="scale">
            <VideoCard id={video.id} title={video.title} lazy={false} shape="tall" />
          </div>
        ) : (
          <div class="stage__media" data-reveal="scale">
            {d.clip ? (
              <figure class="clip">
                <video controls muted playsinline preload="none" poster={d.clip.poster} width="1280" height="480" aria-label={d.clip.caption}>
                  <source src={d.clip.src} type="video/mp4" />
                </video>
                <figcaption><span class="hud-label">{t(lang, 'project.clip')}</span> {d.clip.caption}</figcaption>
              </figure>
            ) : svgKind ? (
              <div class="art"><CoverArt seed={slug} kind={svgKind} label={d.coverAlt} lang={lang} /></div>
            ) : (
              <img class="cover" src={d.cover} alt={d.coverAlt} width="1600" height="1000" />
            )}
          </div>
        )}

        <div class="brief">
          {d.results.length > 0 && (
            <section class="brief__part" aria-labelledby="results-h">
              <h2 class="hud-label" id="results-h"><span class="dot" aria-hidden="true"></span>{t(lang, 'project.results')}</h2>
              <ul class="metrics" data-stagger>
                {d.results.map((r) => (
                  <li class="metric card hud-panel--static" data-reveal>
                    <span class="metric__v">{r.value}</span>
                    <span class="metric__l">{r.label}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
          <section class="brief__part" aria-labelledby="how-h">
            <h2 class="hud-label" id="how-h">{t(lang, 'project.how')}</h2>
            <ol class="flow">
              {d.flow.map((step, i) => (
                <li class="flow__step">
                  <span class="flow__i" aria-hidden="true">{pad(i + 1)}</span>
                  <span class="flow__t">{step}</span>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </section>

      <div class:list={['layout', { 'layout--solo': sources.length === 0 }]}>
        {/* no data-reveal: a long case study must never stay hidden waiting for a reveal */}
        <div class="prose cs"><Content /></div>
        {sources.length > 0 && (
          <aside class="side">
            <div class="side__box card hud-panel--static" data-src data-reveal>
              <h2 class="hud-label">{t(lang, 'project.repo')}</h2>
              <div class="side__links">
                {sources.map((s) => (
                  <button type="button" class:list={['btn', 'btn-sm', { 'btn-primary': s.primary }]} aria-describedby={`src-msg-${slug}`} data-src-btn>
                    {s.primary ? <><Icon name="github" size={18} /> {s.label}</> : <>{s.label} <Icon name="external" size={16} /></>}
                  </button>
                ))}
              </div>
              <p class="side__msg" id={`src-msg-${slug}`} role="status" aria-live="polite" data-src-msg data-text={t(lang, 'project.locked')}></p>
            </div>
          </aside>
        )}
      </div>

      <section class="block" aria-labelledby="stack-h">
        <p class="section-label"><span class="section-label__idx">{pad(d.stack.length)}</span><span class="section-label__sep" aria-hidden="true">//</span>{t(lang, 'project.stack')}</p>
        <h2 id="stack-h" data-decode>{t(lang, 'project.stackTools')}</h2>
        <div class="stack" data-stagger>
          {d.stack.map((g) => (
            <div class="stack__group card hud-panel--static" data-reveal>
              <h3 class="stack__h"><span>{g.group}</span><span class="stack__n" aria-hidden="true">{pad(g.items.length)}</span></h3>
              <ul class="tags">{g.items.map((item) => <li class="tag">{item}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      {d.youtube.length > 1 && (
        <section class="block">
          <p class="section-label"><span class="section-label__idx">{pad(d.youtube.length - 1)}</span><span class="section-label__sep" aria-hidden="true">//</span>{t(lang, 'project.media')}</p>
          <h2 data-decode>{t(lang, 'project.videos')}</h2>
          <div class="vgrid">{d.youtube.slice(1).map((v, i) => <VideoCard id={v.id} title={v.title} index={i + 1} shape="tall" />)}</div>
        </section>
      )}

      {d.gallery.length > 0 && (
        <section class="block">
          <p class="section-label"><span class="section-label__idx">{pad(d.gallery.length)}</span><span class="section-label__sep" aria-hidden="true">//</span>{t(lang, 'project.gallery')}</p>
          <h2 data-decode>{t(lang, 'project.gallery')}</h2>
          <div class="gallery">
            {d.gallery.map((g, i) => (
              <figure class="card hud-panel--static" data-reveal style={`--i:${i}`}>
                <div class="media"><img src={g.src} alt={g.alt} loading="lazy" decoding="async" width="1280" height="800" /></div>
                <figcaption><span class="gi" aria-hidden="true">IMG.{pad(i + 1)}</span>{g.alt}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <nav class="pn" aria-label={`${t(lang, 'project.prev')} / ${t(lang, 'project.next')}`}>
        <a class="card pn__link" href={localize(lang, `/projects/${prev.slug}/`)}>
          <span class="pn__dir"><Icon name="arrow-left" size={14} /> {t(lang, 'project.prev')} · MSN-{pad(prev.entry.data.order)}</span>
          <strong>{prev.entry.data.title}</strong>
        </a>
        <a class="card pn__link next" href={localize(lang, `/projects/${next.slug}/`)}>
          <span class="pn__dir">MSN-{pad(next.entry.data.order)} · {t(lang, 'project.next')} <Icon name="arrow-right" size={14} /></span>
          <strong>{next.entry.data.title}</strong>
        </a>
      </nav>
    </div>
  </article>
</BaseLayout>

<script>
  // One delegated listener survives client-side navigation; the message is re-set each time so screen readers announce it again.
  let timer: number | undefined;
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest?.('[data-src-btn]');
    const msg = btn?.closest('[data-src]')?.querySelector<HTMLElement>('[data-src-msg]');
    if (!msg) return;
    msg.textContent = '';
    window.clearTimeout(timer);
    requestAnimationFrame(() => {
      msg.textContent = msg.dataset.text ?? '';
      timer = window.setTimeout(() => (msg.textContent = ''), 5000);
    });
  });
</script>

<style>
  .phead { position: relative; isolation: isolate; padding-top: calc(var(--header-h) + clamp(28px, 5vw, 64px)); padding-bottom: clamp(32px, 5vw, 56px); border-bottom: 1px solid var(--line); }
  .phead::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(ellipse 70% 90% at 15% 20%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 90% at 15% 20%, #000, transparent 75%);
  }
  .back { display: flex; width: fit-content; align-items: center; gap: 6px; min-height: 44px; margin-bottom: var(--s3); font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent); }
  .phead h1 { margin: var(--s4) 0; max-width: 22ch; }
  .phead .lead { margin: 0; }

  /* Facts: a spec sheet. Hairlines come from the 1px gap over the line colour. */
  .facts {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-flow: row dense; gap: 1px;
    margin: var(--s6) 0 0; padding: 0; background: var(--line); overflow: hidden;
  }
  .fact { background: var(--surface-solid); padding: 14px 18px 16px; min-width: 0; display: grid; gap: 6px; align-content: start; }
  .fact--wide { grid-column: span 2; }
  .fact--full { grid-column: 1 / -1; }
  .facts dt { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .facts dd { margin: 0; font-size: 0.9375rem; font-weight: 550; line-height: 1.45; overflow-wrap: anywhere; }
  .fact__dot { display: inline-block; width: 7px; height: 7px; margin-right: 9px; border-radius: 50%; vertical-align: 2px; background: var(--ok); box-shadow: 0 0 8px var(--ok); }
  .fact__dot--own { background: var(--accent-2); box-shadow: 0 0 8px var(--accent-2); }

  /* Stage: the media, then the two-glance summary (results + how it works). */
  .stage { margin-top: clamp(32px, 5vw, 56px); display: grid; gap: clamp(24px, 4vw, 48px); }
  .stage--video { grid-template-columns: minmax(0, 360px) minmax(0, 1fr); align-items: start; }
  .brief { container: brief / inline-size; display: grid; gap: clamp(24px, 3vw, 36px); align-content: start; min-width: 0; }
  .brief__part { display: grid; gap: var(--s4); }
  .brief__part > .hud-label { gap: 10px; }

  .metrics { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .metric { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .metric__v {
    font-family: var(--font-dot); font-weight: 900; font-size: clamp(1.5rem, 1.25rem + 0.8vw, 1.875rem); line-height: 1; letter-spacing: 0.02em;
    color: var(--accent); text-shadow: 0 0 22px color-mix(in srgb, var(--accent) 45%, transparent); font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .metric__l { color: var(--muted); font-size: 0.875rem; line-height: 1.4; }

  /* How it works: vertical steps by default, a horizontal row once the summary column is wide enough. */
  .flow { list-style: none; padding: 0; margin: 0; display: grid; }
  .flow__step { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 14px; align-items: start; padding-bottom: 20px; }
  .flow__step:last-child { padding-bottom: 0; }
  .flow__step:not(:last-child)::after { content: ''; position: absolute; left: 19.5px; top: 46px; bottom: 6px; width: 1px; background: linear-gradient(var(--accent), var(--line-strong)); }
  .flow__step:not(:last-child)::before {
    content: ''; position: absolute; left: 16.5px; bottom: 6px; width: 7px; height: 7px;
    border-right: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); transform: rotate(45deg);
  }
  .flow__i {
    display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--line-strong); border-radius: 50%;
    background: var(--tint); font-family: var(--font-dot); font-weight: 900; font-size: 0.95rem; letter-spacing: 0.04em; color: var(--accent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .flow__t { padding-top: 9px; font-size: 0.9375rem; line-height: 1.45; }
  @container brief (min-width: 600px) {
    .flow { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); column-gap: 20px; }
    .flow__step { grid-template-columns: minmax(0, 1fr); row-gap: 12px; padding-bottom: 0; }
    .flow__step:not(:last-child)::after { left: 50px; right: -12px; top: 19.5px; bottom: auto; width: auto; height: 1px; background: linear-gradient(90deg, var(--accent), var(--line-strong)); }
    .flow__step:not(:last-child)::before { left: auto; right: -11px; top: 16.5px; bottom: auto; border-bottom: 0; border-top: 1px solid var(--line-strong); }
    .flow__t { padding-top: 0; }
  }

  .stage__media { border: 1px solid var(--line); border-radius: var(--r-card); overflow: hidden; background: var(--bg-2); }
  .cover, .art { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .art { aspect-ratio: 16 / 9; }
  /* no card overlays here, so the mock-up can use the full frame */
  .art :global(.llm__in) { padding: 4cqi 5cqi 5cqi; gap: 3cqi; }
  .clip { margin: 0; }
  .clip video { width: 100%; height: auto; aspect-ratio: 1280 / 480; background: #000; }
  .clip figcaption { padding: 12px 16px; font-size: 0.875rem; color: var(--muted); border-top: 1px solid var(--line); }
  .clip figcaption .hud-label { color: var(--accent); margin-right: 8px; }

  /* Case study text: Problem / Goal and What I built, as short bullets. */
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: clamp(32px, 5vw, 72px); margin-top: clamp(48px, 7vw, 88px); align-items: start; }
  .layout--solo { grid-template-columns: minmax(0, 1fr); }
  .cs :global(h2) { display: flex; align-items: center; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .cs :global(h2)::before { content: ''; flex: none; width: 8px; height: 8px; border: 1px solid var(--accent); transform: rotate(45deg); box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent); }
  .cs :global(li) { line-height: 1.6; }
  .cs :global(li strong) { color: var(--text); }
  .side { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: var(--s4); }
  .side__box { padding: var(--s5); }
  .side__box h2 { margin-bottom: var(--s3); }
  .side__links { display: grid; gap: 8px; position: relative; z-index: 2; }
  .side__msg { margin: 0; font-size: 0.875rem; line-height: 1.45; color: var(--warn); }
  .side__msg:not(:empty) { margin-top: var(--s3); }

  .block { margin-top: clamp(56px, 8vw, 104px); }
  .block > h2 { margin: var(--s3) 0 var(--s5); }
  .stack { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--s4); }
  .stack__group { padding: 16px 18px 18px; display: grid; gap: 12px; align-content: start; }
  .stack__h {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 0; padding-bottom: 10px; border-bottom: 1px dashed var(--line-strong);
    font-family: var(--font-mono); font-size: var(--fs-micro); font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);
  }
  .stack__n { font-family: var(--font-dot); font-weight: 900; font-size: 1rem; color: var(--faint); }
  .stack .tag { white-space: normal; color: var(--text); }

  .vgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 300px)); gap: var(--s5); }
  .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s5); }
  .gallery figure { margin: 0; }
  .gallery figcaption { display: flex; gap: 10px; align-items: baseline; padding: 12px 16px; font-size: 0.875rem; color: var(--muted); border-top: 1px solid var(--line); }
  .gi { flex: none; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em; color: var(--accent); }

  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4); margin: clamp(56px, 8vw, 112px) 0 var(--section); }
  .pn__link { padding: var(--s5); text-decoration: none; display: flex; flex-direction: column; gap: 8px; }
  .pn__dir { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .pn__link strong { font-family: var(--font-display); font-weight: 600; font-size: 1.0625rem; line-height: 1.3; }
  .pn__link:hover strong { color: var(--accent); }
  .pn__link.next { text-align: right; align-items: flex-end; }

  @media (max-width: 1024px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
  }
  @media (max-width: 760px) {
    .stage--video { grid-template-columns: minmax(0, 1fr); }
    .stage__video { width: min(100%, 380px); margin-inline: auto; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fact--wide, .fact--pair { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .gallery, .pn { grid-template-columns: minmax(0, 1fr); }
    .pn__link.next { text-align: left; align-items: flex-start; }
    .vgrid { grid-template-columns: minmax(0, 1fr); justify-items: center; }
  }
  @media (max-width: 420px) {
    .facts { grid-template-columns: minmax(0, 1fr); }
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
