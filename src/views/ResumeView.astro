---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;

/* The owner drops new PDFs into public/resume/ under these exact names;
   the file size is read at build time so the cards stay accurate. */
const sizeOf = (file: string) => {
  try {
    const kb = statSync(join(process.cwd(), 'public', file)).size / 1024;
    return kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${Math.round(kb)} KB`;
  } catch {
    return '';
  }
};
// `url` points at the live site (Astro.site), so a PDF printed from this page links there, not to localhost.
const files = [
  { code: 'EN', key: 'en', name: 'English', href: '/resume/Tokhirbek_Aminjonov_Resume_EN.pdf', hreflang: 'en' },
  { code: 'KO', key: 'ko', name: '한국어', href: '/resume/Tokhirbek_Aminjonov_Resume_KO.pdf', hreflang: 'ko' },
].map((f) => ({ ...f, size: sizeOf(f.href), url: new URL(f.href, Astro.site).href }));
// Show the page language first in the preview.
const first = files.find((f) => f.key === lang) ?? files[0];
---
<BaseLayout lang={lang} title={t(lang, 'resume.title')} description={t(lang, 'resume.lead')}>
  <PageHead code="CV" label={t(lang, 'resume.label')} title={t(lang, 'resume.title')} lead={t(lang, 'resume.lead')} />
  <section class="section">
    <div class="container">
      <p class="summary" data-reveal>{t(lang, 'resume.summaryLine')}</p>

      <ul class="files" data-stagger>
        {files.map((f) => (
          <li class="hud-panel file" data-reveal>
            <span class="file__code" aria-hidden="true">{f.code}</span>
            <div class="file__body">
              <h2 class="file__name" lang={f.hreflang}>{f.name}</h2>
              <p class="file__meta">PDF{f.size && ` · ${f.size}`} · A4</p>
            </div>
            <div class="file__actions">
              <a class="btn btn-primary" href={f.url} download data-astro-prefetch="false" hreflang={f.hreflang} data-magnetic>
                <Icon name="download" /> {t(lang, f.key === 'en' ? 'resume.download.en' : 'resume.download.ko')}
              </a>
              <a class="btn btn-ghost" href={f.url} target="_blank" rel="noopener" data-astro-prefetch="false" hreflang={f.hreflang}>
                <Icon name="external" /> {t(lang, 'resume.open')}
              </a>
            </div>
          </li>
        ))}
      </ul>

      <div class="preview hud-panel hud-panel--static" data-reveal data-pdf-preview>
        <div class="preview__bar">
          <span class="hud-label">{t(lang, 'resume.preview')}</span>
          <div class="preview__tabs" role="group" aria-label={t(lang, 'resume.preview')}>
            {files.map((f) => (
              <button type="button" class="preview__tab" data-pdf={f.href} data-pdf-url={f.url} data-pdf-title={`${t(lang, 'resume.title')} (${f.name})`} aria-pressed={f === first ? 'true' : 'false'}>{f.code}</button>
            ))}
          </div>
        </div>
        <div class="preview__frame" data-pdf-frame data-src={first.href} data-title={`${t(lang, 'resume.title')} (${first.name})`}>
          <p class="preview__fallback">
            <a href={first.url} target="_blank" rel="noopener" data-astro-prefetch="false">{t(lang, 'resume.open')} ({first.name})</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* The PDF preview is only built on wide screens: most mobile browsers do not
     render PDFs inline, so phones use the Open buttons and skip the download. */
  let ac: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;
    const root = document.querySelector<HTMLElement>('[data-pdf-preview]');
    const host = root?.querySelector<HTMLElement>('[data-pdf-frame]');
    if (!root || !host) return;
    const mq = matchMedia('(min-width: 900px)');
    let frame: HTMLIFrameElement | null = null;
    const mount = () => {
      if (frame || !mq.matches) return;
      frame = document.createElement('iframe');
      frame.src = `${host.dataset.src}#view=FitH`;
      frame.title = host.dataset.title ?? '';
      frame.loading = 'lazy';
      host.replaceChildren(frame);
    };
    mount();
    mq.addEventListener('change', mount, { signal });
    root.querySelectorAll<HTMLButtonElement>('[data-pdf]').forEach((tab) => {
      tab.addEventListener(
        'click',
        () => {
          root.querySelectorAll('[data-pdf]').forEach((b) => b.setAttribute('aria-pressed', String(b === tab)));
          host.dataset.src = tab.dataset.pdf;
          host.dataset.title = tab.dataset.pdfTitle;
          const link = host.querySelector<HTMLAnchorElement>('a');
          if (link) link.href = tab.dataset.pdfUrl ?? '';
          if (frame) {
            frame.src = `${tab.dataset.pdf}#view=FitH`;
            frame.title = tab.dataset.pdfTitle ?? '';
          }
        },
        { signal }
      );
    });
  });
</script>

<style>
  .summary { max-width: 62ch; font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); color: var(--text); margin: 0 0 var(--s7); padding-left: var(--s4); border-left: 2px solid var(--accent); }
  .files { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s5); }
  .file { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s4) var(--s5); align-items: center; padding: clamp(20px, 3.5vw, 36px); }
  .file > * { position: relative; z-index: 2; }
  .file__code { font-family: var(--font-dot); font-weight: 900; font-size: clamp(3rem, 2rem + 4vw, 4.75rem); line-height: 0.9; letter-spacing: 0.04em; color: var(--accent); text-shadow: 0 0 24px color-mix(in srgb, var(--accent) 40%, transparent); }
  .file__name { font-size: var(--fs-h3); margin: 0 0 6px; }
  .file__meta { margin: 0; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--muted); }
  .file__actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 10px; }

  .preview { margin-top: var(--s6); padding: 0; }
  .preview > * { position: relative; z-index: 2; }
  .preview__bar { display: flex; justify-content: space-between; align-items: center; gap: var(--s4); padding: 10px var(--s4); border-bottom: 1px solid var(--line); }
  .preview__tabs { display: flex; gap: 4px; }
  .preview__tab { min-width: 44px; min-height: 36px; padding: 0 12px; border: 1px solid var(--line); border-radius: var(--r-btn); background: transparent; cursor: pointer; font-family: var(--font-mono); font-size: var(--fs-micro); font-weight: 600; letter-spacing: var(--track-mono); color: var(--muted); }
  .preview__tab:hover { border-color: var(--accent); color: var(--accent); }
  .preview__tab[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .preview__frame { height: min(82vh, 1100px); background: var(--bg-2); }
  .preview__frame :global(iframe) { display: block; width: 100%; height: 100%; border: 0; background: #fff; }
  .preview__fallback { margin: 0; padding: var(--s5); }

  /* Phones open the PDF from the cards above instead */
  @media (max-width: 899px) { .preview { display: none; } }
  @media (max-width: 760px) { .files { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .file__actions .btn { flex: 1 1 100%; } }
</style>
