---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { t, localize, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<BaseLayout lang={lang} title="404" description={t(lang, '404.body')} hasAlternate={false} noindex>
  <section class="nf grid-bg">
    <div class="container">
      <svg viewBox="0 0 360 120" class="path" aria-hidden="true">
        <path d="M20 90 L110 30 L210 70 L300 30" pathLength="1" />
        <circle cx="20" cy="90" r="8" /><circle cx="110" cy="30" r="8" /><circle cx="210" cy="70" r="8" /><circle cx="300" cy="30" r="8" class="end" />
        <text x="318" y="36">?</text>
      </svg>
      <p class="label">404</p>
      <h1 data-split>{t(lang, '404.title')}</h1>
      <p class="lead">{t(lang, '404.body')}</p>
      <a class="btn btn-primary" href={localize(lang, '/')}><Icon name="arrow-left" /> {t(lang, '404.home')}</a>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 100vh; display: grid; align-items: center; padding: calc(var(--header-h) + 48px) 0 64px; }
  .path { width: min(360px, 100%); margin-bottom: var(--s6); }
  .path path { fill: none; stroke: var(--accent); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; animation: d 2.4s var(--ease) forwards; }
  .path circle { fill: var(--bg); stroke: var(--ink); stroke-width: 3; }
  .path .end { stroke: var(--accent); }
  .path text { font: 800 28px var(--font-head); fill: var(--accent); }
  @keyframes d { to { stroke-dashoffset: 0; } }
  h1 { margin: var(--s3) 0 var(--s4); max-width: 18ch; }
  .lead { margin-bottom: var(--s6); }
</style>
