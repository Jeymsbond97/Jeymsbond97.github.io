---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { t, localize, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<BaseLayout lang={lang} title="404" description={t(lang, '404.body')} hasAlternate={false} noindex>
  <section class="nf">
    <div class="container nf__grid">
      <div class="nf__copy">
        <p class="section-label"><span class="section-label__idx">ERR.404</span><span class="section-label__sep" aria-hidden="true">//</span>{t(lang, 'notfound.label')}</p>
        <h1 data-decode>{t(lang, '404.title')}</h1>
        <p class="lead">{t(lang, '404.body')}</p>
        <div class="nf__actions">
          <a class="btn btn-primary" href={localize(lang, '/')} data-magnetic><Icon name="arrow-left" /> {t(lang, '404.home')}</a>
          <a class="btn btn-ghost" href={localize(lang, '/projects/')}>{t(lang, 'nav.projects')}</a>
        </div>
      </div>

      <div class="scope" aria-hidden="true">
        <svg viewBox="0 0 240 240">
          <circle class="ring" cx="120" cy="120" r="110" />
          <circle class="ring" cx="120" cy="120" r="76" />
          <circle class="ring" cx="120" cy="120" r="42" />
          <path class="axis" d="M120 4v232M4 120h232" />
          <g class="sweep"><path d="M120 120 L120 10 A110 110 0 0 1 197.8 42.2 Z" /></g>
          <circle class="blip" cx="168" cy="78" r="4" />
          <circle class="blip blip--echo" cx="168" cy="78" r="4" />
        </svg>
        <span class="scope__code">404</span>
        <span class="scope__readout">{t(lang, 'notfound.readout')}</span>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 100vh; min-height: 100svh; display: grid; align-items: center; padding: calc(var(--header-h) + 48px) 0 64px; }
  .nf__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--s7); align-items: center; }
  h1 { margin: var(--s4) 0; max-width: 16ch; }
  .lead { margin-bottom: var(--s6); }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 10px; }

  .scope { position: relative; width: min(360px, 100%); margin-inline: auto; aspect-ratio: 1; }
  .scope svg { width: 100%; height: 100%; overflow: visible; }
  .ring { fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .axis { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 4; }
  .sweep { transform-origin: 120px 120px; animation: sweep 4s linear infinite; }
  .sweep path { fill: color-mix(in srgb, var(--accent) 14%, transparent); stroke: none; }
  .blip { fill: var(--danger); }
  .blip--echo { fill: none; stroke: var(--danger); transform-origin: 168px 78px; animation: echo 2s var(--ease) infinite; }
  .scope__code { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-dot); font-weight: 900; font-size: clamp(3.5rem, 2rem + 6vw, 5.5rem); letter-spacing: 0.06em; color: var(--accent); text-shadow: 0 0 28px color-mix(in srgb, var(--accent) 45%, transparent); animation: flicker 3.2s steps(1) infinite; }
  .scope__readout { position: absolute; left: 50%; bottom: -28px; transform: translateX(-50%); white-space: nowrap; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--faint); }
  @keyframes sweep { to { transform: rotate(360deg); } }
  @keyframes echo { from { transform: scale(1); opacity: 0.9; } to { transform: scale(4); opacity: 0; } }
  @keyframes flicker { 0%, 100% { opacity: 1; } 47% { opacity: 0.55; } 49% { opacity: 1; } 83% { opacity: 0.7; } 85% { opacity: 1; } }
  @media (max-width: 820px) {
    .nf__grid { grid-template-columns: 1fr; }
    .scope { order: -1; width: min(220px, 70%); margin: 0 0 var(--s7); }
  }
</style>
