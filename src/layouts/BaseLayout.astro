---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/doto/700.css';
import '@fontsource/doto/800.css';
import '@fontsource/doto/900.css';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, alternatePath, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
  hasAlternate?: boolean;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}
const { lang, title, description, image, hasAlternate = true, type = 'website', noindex = false } = Astro.props;
const site = Astro.site!;
const path = Astro.url.pathname;
const canonical = new URL(path, site).href;
const ogImage = new URL(image ?? '/og-image.png', site).href;
const fullTitle = title.includes('Tokhirbek') ? title : `${title} · Tokhirbek Aminjonov`;
const enHref = new URL(alternatePath(path, 'en'), site).href;
const koHref = new URL(alternatePath(path, 'ko'), site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.nickname,
  jobTitle: 'Robot Software Engineer',
  url: new URL('/', site).href,
  image: new URL('/headshot.jpg', site).href,
  email: `mailto:${profile.email}`,
  worksFor: { '@type': 'Organization', name: 'Cutshion' },
  address: { '@type': 'PostalAddress', addressLocality: 'Seoul', addressCountry: 'KR' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Jeonbuk National University' },
  sameAs: [profile.links.linkedin, profile.links.github, profile.links.youtube],
  knowsAbout: ['ROS 2', 'Collaborative robots', 'JAKA', 'Computer vision', 'YOLO', 'TensorRT', 'NVIDIA Jetson', 'PLC', 'Modbus', 'Factory automation', 'Service robots', 'Reinforcement learning', 'MuJoCo', 'Isaac Lab'],
};
---
<!doctype html>
<html lang={lang} class="no-js" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    {hasAlternate && <link rel="alternate" hreflang="en" href={enHref} />}
    {hasAlternate && <link rel="alternate" hreflang="ko" href={koHref} />}
    {hasAlternate && <link rel="alternate" hreflang="x-default" href={enHref} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Tokhirbek Aminjonov · Blog" href="/rss.xml" />
    <meta name="theme-color" content="#f3f6f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#02040a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Tokhirbek Aminjonov" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        var apply = function () {
          var s = null;
          try { s = localStorage.getItem('theme'); } catch (e) {}
          // Stored choice first; otherwise follow the OS, with dark as the brand default.
          var dark = s ? s === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        };
        apply();
        document.addEventListener('astro:after-swap', function () { apply(); document.documentElement.classList.remove('no-js'); });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <Header lang={lang} hasAlternate={hasAlternate} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="xhair" data-xhair aria-hidden="true">
      <div class="xhair__h"></div>
      <div class="xhair__v"></div>
      <span class="xhair__xy">X 0000  Y 0000</span>
    </div>
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style is:global>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--accent-2), var(--accent)); box-shadow: var(--glow); transform-origin: left; transform: scaleX(0); z-index: 60; pointer-events: none; }
  .yt-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
