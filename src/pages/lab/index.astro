---
/* Design lab: style options for the case study "Stack and tools" and "How it works" blocks.
   Not linked from the site and not indexed; removed once the owner picks. */
import BaseLayout from '../../layouts/BaseLayout.astro';

const stack = [
  { group: 'Languages', items: ['Python', 'TypeScript', 'C++'] },
  { group: 'Frameworks', items: ['FastAPI', 'React Native', 'ROS 2'] },
  { group: 'AI / Vision', items: ['YOLO', 'TensorRT', 'whisper.cpp', 'Ollama', 'Gemma', 'TTS', 'Hand-eye calibration'] },
  { group: 'Robot / Hardware', items: ['JAKA Lumi', 'Jetson AGX Thor', '2 × RGB-D cameras', '6-mic array', 'Lidar base', '6-axis arm + gripper'] },
  { group: 'Protocols', items: ['REST API', 'WebSocket'] },
  { group: 'Tools', items: ['Swagger', 'Docker', 'Git'] },
];
const steps = [
  'A visitor says "Hi Lumi" and asks in their own words',
  'Speech becomes text on the robot itself',
  'A local LLM turns the request into robot tasks',
  'The cameras locate the person or object',
  'Lumi answers, drives there or picks the object up',
];
---
<BaseLayout lang="en" title="Design lab" description="Style options" noindex hasAlternate={false}>
  <div class="container lab">
    <p class="hud-label">DESIGN LAB · pick one of each</p>
    <h1>Stack and tools: 4 options</h1>

    <!-- S1 -->
    <section class="opt">
      <p class="tag-id">S1 · Spec sheet</p>
      <div class="s1">
        {stack.map((g) => (
          <div class="s1__row"><span class="s1__k">{g.group}</span><span class="s1__v">{g.items.join('  ·  ')}</span></div>
        ))}
      </div>
    </section>

    <!-- S2 -->
    <section class="opt">
      <p class="tag-id">S2 · Colour-coded cloud</p>
      <div class="s2">
        {stack.map((g, gi) => g.items.map((it) => <span class="s2__chip" style={`--c:${['#40e6ff','#9a7bff','#3ef08a','#ffb84d','#ff7ab6','#8fa0ab'][gi]}`}><i></i>{it}</span>))}
      </div>
      <div class="s2__legend">
        {stack.map((g, gi) => <span style={`--c:${['#40e6ff','#9a7bff','#3ef08a','#ffb84d','#ff7ab6','#8fa0ab'][gi]}`}><i></i>{g.group}</span>)}
      </div>
    </section>

    <!-- S3 -->
    <section class="opt">
      <p class="tag-id">S3 · Terminal</p>
      <div class="s3">
        <p><span class="s3__p">tokhirbek@lumi:~$</span> cat stack.yml</p>
        {stack.map((g) => <p><span class="s3__k">{g.group.toLowerCase().replace(' / ', '_').replace(' ', '_')}</span>: <span class="s3__v">[{g.items.join(', ')}]</span></p>)}
        <p><span class="s3__p">tokhirbek@lumi:~$</span> <span class="s3__cur"></span></p>
      </div>
    </section>

    <!-- S4 -->
    <section class="opt">
      <p class="tag-id">S4 · Open columns</p>
      <div class="s4">
        {stack.map((g) => (
          <div class="s4__col"><p class="s4__k">{g.group}</p><ul>{g.items.map((it) => <li>{it}</li>)}</ul></div>
        ))}
      </div>
    </section>

    <h1>How it works: 4 options (animated)</h1>

    <!-- H1 -->
    <section class="opt">
      <p class="tag-id">H1 · Signal beam: a light pulse runs the pipeline, each step lights up in turn</p>
      <ol class="h1" style={`--n:${steps.length}`}>
        <span class="h1__beam" aria-hidden="true"></span>
        {steps.map((s, i) => <li style={`--i:${i}`}><span class="h1__dot">{String(i + 1).padStart(2, '0')}</span><span class="h1__t">{s}</span></li>)}
      </ol>
    </section>

    <!-- H2 -->
    <section class="opt">
      <p class="tag-id">H2 · Vertical scan: a scan line moves down and reveals each step</p>
      <ol class="h2" style={`--n:${steps.length}`}>
        <span class="h2__scan" aria-hidden="true"></span>
        {steps.map((s, i) => <li style={`--i:${i}`}><span class="h2__n">{String(i + 1).padStart(2, '0')}</span><span>{s}</span></li>)}
      </ol>
    </section>

    <!-- H3 -->
    <section class="opt">
      <p class="tag-id">H3 · Step cards: the active card lifts and fills its progress bar, then hands over</p>
      <ol class="h3" style={`--n:${steps.length}`}>
        {steps.map((s, i) => <li style={`--i:${i}`}><span class="h3__n">{String(i + 1).padStart(2, '0')}</span><span class="h3__t">{s}</span><span class="h3__bar"><i></i></span></li>)}
      </ol>
    </section>

    <!-- H4 -->
    <section class="opt">
      <p class="tag-id">H4 · Orbit: steps sit on a ring, a satellite travels and highlights the current one</p>
      <div class="h4" style={`--n:${steps.length}`}>
        <div class="h4__ring" aria-hidden="true"><span class="h4__sat"></span><span class="h4__core">LUMI</span></div>
        <ol>{steps.map((s, i) => <li style={`--i:${i}`}><span class="h4__n">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}</ol>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .lab { padding-block: calc(var(--header-h, 72px) + 40px) 120px; display: grid; gap: 28px; }
  .lab h1 { font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.4rem); margin: 40px 0 0; }
  .opt { display: grid; gap: 16px; padding: 28px 0; border-top: 1px dashed var(--line-strong); }
  .tag-id { margin: 0; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  /* S1 */
  .s1__row { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .s1__k { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); padding-top: 3px; }
  .s1__v { font-size: 1.05rem; color: var(--text); white-space: pre-wrap; }
  @media (max-width: 640px) { .s1__row { grid-template-columns: 1fr; gap: 4px; } }
  /* S2 */
  .s2 { display: flex; flex-wrap: wrap; gap: 10px 18px; font-size: 1.05rem; }
  .s2__chip { display: inline-flex; align-items: center; gap: 8px; color: var(--text); }
  .s2__chip i, .s2__legend i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 10px var(--c); }
  .s2__legend { display: flex; flex-wrap: wrap; gap: 8px 20px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .s2__legend span { display: inline-flex; align-items: center; gap: 6px; }
  /* S3 */
  .s3 { margin: 0; padding: 22px 24px; border-radius: 8px; background: #050a12; border: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.9rem; line-height: 1.9; color: #cfe6ef; overflow-x: auto; }
  .s3 p { margin: 0; }
  .s3__p { color: #3ef08a; } .s3__k { color: #40e6ff; } .s3__v { color: #eef2f5; }
  .s3__cur { display: inline-block; width: 9px; height: 1.1em; vertical-align: -0.2em; background: #40e6ff; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  /* S4 */
  .s4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0; }
  .s4__col { padding: 4px 22px 4px 0; border-left: 1px solid var(--line); padding-left: 18px; }
  .s4__k { margin: 0 0 12px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .s4 ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; color: var(--text); }
  /* shared step timing: one cycle walks through all steps */
  .h1, .h2, .h3, .h4 { --dur: calc(var(--n) * 1.4s); }
  /* H1 */
  .h1 { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 16px; }
  .h1::before { content: ''; position: absolute; left: 22px; right: 22px; top: 22px; height: 1px; background: var(--line-strong); }
  .h1__beam { position: absolute; top: 19px; left: 22px; width: 60px; height: 7px; border-radius: 4px; background: linear-gradient(90deg, transparent, var(--accent)); filter: drop-shadow(0 0 8px var(--accent)); animation: beam var(--dur) linear infinite; }
  @keyframes beam { from { transform: translateX(-40px); } to { transform: translateX(calc(100cqw - 60px)); } }
  .h1 { container-type: inline-size; }
  .h1 li { position: relative; display: grid; gap: 12px; }
  .h1__dot { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--bg); font-family: var(--font-dot); color: var(--muted); animation: lit var(--dur) linear infinite; animation-delay: calc(var(--i) * 1.4s); }
  .h1__t { color: var(--muted); animation: litt var(--dur) linear infinite; animation-delay: calc(var(--i) * 1.4s); }
  @keyframes lit { 0%, 22% { color: var(--accent); border-color: var(--accent); box-shadow: 0 0 18px var(--accent); } 30%, 100% { color: var(--muted); border-color: var(--line-strong); box-shadow: none; } }
  @keyframes litt { 0%, 22% { color: var(--text); } 30%, 100% { color: var(--muted); } }
  @media (max-width: 760px) { .h1 { grid-template-columns: 1fr; } .h1::before, .h1__beam { display: none; } .h1 li { grid-template-columns: 44px 1fr; align-items: center; } }
  /* H2 */
  .h2 { position: relative; list-style: none; margin: 0; padding: 0 0 0 28px; display: grid; gap: 0; border-left: 1px solid var(--line-strong); overflow: hidden; }
  .h2 li { display: grid; grid-template-columns: 56px 1fr; gap: 12px; padding: 16px 0; font-size: 1.1rem; color: var(--faint); animation: scanlit var(--dur) linear infinite; animation-delay: calc(var(--i) * 1.4s); }
  .h2__n { font-family: var(--font-dot); font-size: 1.6rem; color: inherit; }
  .h2__scan { position: absolute; left: 0; right: 0; height: 2px; background: var(--accent); box-shadow: 0 0 14px var(--accent); animation: scan var(--dur) linear infinite; }
  @keyframes scan { from { top: 0; } to { top: 100%; } }
  @keyframes scanlit { 0%, 20% { color: var(--text); } 34%, 100% { color: var(--faint); } }
  /* H3 */
  .h3 { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 12px; }
  .h3 li { position: relative; display: grid; gap: 10px; align-content: start; padding: 18px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); animation: lift var(--dur) ease-in-out infinite; animation-delay: calc(var(--i) * 1.4s); }
  .h3__n { font-family: var(--font-dot); font-size: 1.8rem; color: var(--accent); }
  .h3__t { color: var(--text); }
  .h3__bar { height: 2px; background: var(--line); overflow: hidden; }
  .h3__bar i { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); animation: fill var(--dur) linear infinite; animation-delay: calc(var(--i) * 1.4s); }
  @keyframes lift { 0%, 22% { transform: translateY(-6px); border-color: var(--accent); box-shadow: 0 16px 40px -20px var(--accent); } 30%, 100% { transform: none; border-color: var(--line); box-shadow: none; } }
  @keyframes fill { 0% { transform: scaleX(0); } 22% { transform: scaleX(1); } 23%, 100% { transform: scaleX(0); } }
  @media (max-width: 900px) { .h3 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .h3 { grid-template-columns: 1fr; } }
  /* H4 */
  .h4 { display: grid; grid-template-columns: 260px 1fr; gap: 40px; align-items: center; }
  .h4__ring { position: relative; width: 240px; aspect-ratio: 1; border-radius: 50%; border: 1px dashed var(--line-strong); display: grid; place-items: center; }
  .h4__core { font-family: var(--font-dot); font-size: 2rem; color: var(--accent); text-shadow: 0 0 18px var(--accent); }
  .h4__sat { position: absolute; inset: 0; animation: orbit var(--dur) linear infinite; }
  .h4__sat::after { content: ''; position: absolute; top: -6px; left: calc(50% - 6px); width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 16px var(--accent); }
  @keyframes orbit { to { transform: rotate(360deg); } }
  .h4 ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .h4 li { display: grid; grid-template-columns: 40px 1fr; gap: 10px; color: var(--muted); font-size: 1.05rem; animation: litt var(--dur) linear infinite; animation-delay: calc(var(--i) * 1.4s); }
  .h4__n { font-family: var(--font-dot); color: var(--accent); }
  @media (max-width: 760px) { .h4 { grid-template-columns: 1fr; justify-items: center; } }
  @media (prefers-reduced-motion: reduce) { .lab * { animation: none !important; } }
</style>
